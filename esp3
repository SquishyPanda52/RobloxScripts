local function hideVisuals(data)
	if data.Highlight then
		data.Highlight:Destroy()
		data.Highlight = nil
	end
	if data.Billboard then
		data.Billboard.Enabled = false
		data.Billboard.Adornee = nil
	end
end

local function ensureVisuals(player, data)
	if not data.Highlight or data.Highlight.Parent ~= effectsFolder then
		if data.Highlight then
			data.Highlight:Destroy()
		end
		data.Highlight = make("Highlight", {
			Name = "RuntimeHighlight_" .. player.UserId,
			Enabled = false,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		}, effectsFolder)
	end

	local tagValid = data.Billboard
		and data.Billboard.Parent == PlayerGui
		and data.NameLabel
		and data.NameLabel.Parent == data.Billboard
		and data.Stroke
		and data.Stroke.Parent == data.NameLabel

	if not tagValid then
		if data.Billboard then
			data.Billboard:Destroy()
		end

		-- Parent to PlayerGui instead of a body part.
		-- Adornee is rebound repeatedly as parts arrive or change.
		data.Billboard = make("BillboardGui", {
			Name = "RuntimeNameTag_" .. player.UserId,
			Size = UDim2.fromOffset(240, 44),
			AlwaysOnTop = true,
			MaxDistance = math.huge,
			StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
			Enabled = false,
			ResetOnSpawn = false,
		}, PlayerGui)

		data.NameLabel = make("TextLabel", {
			Name = "NameLabel",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = player.Name,
			Font = Enum.Font.GothamBold,
			TextSize = 18,
			TextColor3 = WHITE,
			TextStrokeTransparency = 1,
			TextWrapped = false,
		}, data.Billboard)

		data.Stroke = make("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Color = BLACK,
			Thickness = 1,
			Transparency = 0,
		}, data.NameLabel)
	end
end

local function updateVisuals(player, data)
	if not data.Wanted or not data.Available then
		hideVisuals(data)
		return
	end

	local character = data.Character
	local anchor = partNamed(character, "Head") or data.Part
	if not anchor or not anchor:IsDescendantOf(Workspace) then
		hideVisuals(data)
		return
	end

	ensureVisuals(player, data)

	local fillColor = WHITE
	local outlineColor = BLACK
	local fillAlpha = 1
	local outlineAlpha = 1

	if allEnabled then
		fillColor = Color3.fromRGB(0, 255, 0)
		outlineColor = fillColor
		fillAlpha = allTransparency.GetValue()
		outlineAlpha = fillAlpha
	elseif data.TeamVisible then
		fillColor = teamColor(player)
		outlineColor = fillColor
		fillAlpha = teamTransparency.GetValue()
		outlineAlpha = fillAlpha
	end

	local exposure = data.Visibility

	if exposure >= 1 then
		fillColor = fillColor:Lerp(WHITE, 0.23)
		outlineColor = outlineColor:Lerp(WHITE, 0.23)
		if fillAlpha < 1 then
			fillAlpha = math.max(0, fillAlpha - 0.07)
		end
		if outlineAlpha < 1 then
			outlineAlpha = math.max(0, outlineAlpha - 0.04)
		end
	elseif exposure > 0 then
		fillColor = fillColor:Lerp(BLACK, 0.18)
		outlineColor = outlineColor:Lerp(BLACK, 0.18)
		if fillAlpha < 1 then
			fillAlpha = math.min(1, fillAlpha + 0.16)
		end
		if outlineAlpha < 1 then
			outlineAlpha = math.min(1, outlineAlpha + 0.12)
		end
	else
		fillColor = fillColor:Lerp(BLACK, 0.52)
		outlineColor = outlineColor:Lerp(BLACK, 0.52)
		if fillAlpha < 1 then
			fillAlpha = math.min(1, fillAlpha + 0.38)
		end
		if outlineAlpha < 1 then
			outlineAlpha = math.min(1, outlineAlpha + 0.34)
		end
	end

	-- Apply specific-target priority AFTER visibility shading.
	if data.Specific then
		outlineColor = YELLOW
		outlineAlpha = specificTransparency.GetValue()
	end

	local highlight = data.Highlight
	highlight.Adornee = character
	highlight.FillColor = fillColor
	highlight.OutlineColor = outlineColor
	highlight.FillTransparency = fillAlpha
	highlight.OutlineTransparency = outlineAlpha
	highlight.Enabled = true

	local size = nameSize.GetValue()
	data.Billboard.Size = UDim2.fromOffset(
		math.max(220, #player.Name * size * 0.8 + 28),
		size + 18
	)

	-- Reattach every update: handles respawns, delayed Heads,
	-- replaced body parts, and streaming back into range.
	data.Billboard.Adornee = anchor
	data.Billboard.StudsOffsetWorldSpace = Vector3.new(
		0, anchor.Name == "Head" and 2 or 3.5, 0
	)
	data.Billboard.Enabled = true

	data.NameLabel.Text = player.Name
	data.NameLabel.TextSize = size
	data.NameLabel.Visible = true
	data.NameLabel.TextColor3 = teamColor(player)
	data.NameLabel.TextStrokeTransparency = 1

	if data.Specific then
		data.NameLabel.TextTransparency = 0
		data.Stroke.Color = YELLOW
		data.Stroke.Thickness = 1.5
		data.Stroke.Transparency = specificTransparency.GetValue()
	else
		data.NameLabel.TextTransparency =
			exposure == 0 and 0.45 or (exposure < 1 and 0.18 or 0)
		data.Stroke.Color = BLACK
		data.Stroke.Thickness = 1
		data.Stroke.Transparency = 0
	end
end

---------------------------------------------------------------------
-- PLAYER / CHARACTER LIFECYCLE
---------------------------------------------------------------------

local function resetCharacter(data, character)
	hideVisuals(data)

	data.Character = character
	data.Part = nil
	data.Position = nil
	data.SeenAt = nil
	data.Available = false
	data.Visibility = 1

	if data.Marker then
		data.Marker.Visible = false
	end
end

local function watchPlayer(player)
	if player == LocalPlayer or records[player] then
		return
	end

	local data = {
		Character = nil,
		RemovingCharacter = nil,
		Available = false,
		Visibility = 1,
		Specific = false,
		Wanted = false,
		Connections = {},
	}
	records[player] = data

	-- Connect before inspecting the current character.
	-- No WaitForChild timeout can cause a spawn to be missed.
	table.insert(data.Connections, player.CharacterAdded:Connect(function(character)
		if stopped or records[player] ~= data then
			return
		end
		data.RemovingCharacter = nil
		resetCharacter(data, character)
	end))

	table.insert(data.Connections, player.CharacterRemoving:Connect(function(character)
		if records[player] ~= data then
			return
		end
		data.RemovingCharacter = character
		if data.Character == character then
			-- Never guide toward coordinates from a previous life.
			resetCharacter(data, nil)
		end
	end))

	if player.Character then
		resetCharacter(data, player.Character)
	end
end

local function removePlayer(player)
	local data = records[player]
	if not data then
		return
	end

	for _, connection in ipairs(data.Connections) do
		connection:Disconnect()
	end

	hideVisuals(data)
	if data.Billboard then
		data.Billboard:Destroy()
	end
	if data.Marker then
		data.Marker:Destroy()
	end

	records[player] = nil
end

local function samplePlayer(player, data, now)
	local character = player.Character
	if character == data.RemovingCharacter then
		character = nil
	end

	if character and character ~= data.Character then
		data.RemovingCharacter = nil
		resetCharacter(data, character)
	end

	data.Available = false
	data.Part = nil

	if character and character:IsDescendantOf(Workspace) then
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if humanoid and humanoid.Health <= 0 then
			data.Position = nil
			data.SeenAt = nil
		else
			local part = positionPart(character)
			if part then
				data.Part = part
				data.Position = part.Position
				data.SeenAt = now
				data.Available = true
			end
		end
	end

	-- When body parts stream out, retain the most recent observed position.
	data.Specific = specificEnabled and isSpecific(player)

	local sameTeam = LocalPlayer.Team ~= nil
		and player.Team == LocalPlayer.Team

	data.TeamVisible = teamEnabled
		and not (hideTeamEnabled and sameTeam)

	data.Wanted = allEnabled or data.TeamVisible or data.Specific
end

connect(Players.PlayerAdded, watchPlayer)
connect(Players.PlayerRemoving, removePlayer)

for _, player in ipairs(Players:GetPlayers()) do
	watchPlayer(player)
end


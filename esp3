local function slider(text, minimum, maximum, default)
	local frame = row(44)
	textLabel(frame, text, UDim2.new(0.8, 0, 0, 20))

	local valueLabel = textLabel(
		frame, "", UDim2.new(0.2, 0, 0, 20),
		UDim2.fromScale(0.8, 0)
	)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local track = make("Frame", {
		Size = UDim2.new(1, -12, 0, 20),
		Position = UDim2.fromOffset(6, 22),
		BackgroundTransparency = 1,
		Active = true,
	}, frame)

	local bar = make("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		BackgroundColor3 = Color3.fromRGB(70, 70, 70),
		BorderSizePixel = 0,
	}, track)
	round(bar, 3)

	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 18),
		BackgroundColor3 = Color3.fromRGB(210, 210, 210),
		BorderSizePixel = 0,
		Active = true,
	}, track)
	round(knob, 4)

	local value = default
	local dragInput = nil

	local function setValue(newValue)
		value = math.clamp(
			math.floor(newValue * 10 + 0.5) / 10,
			minimum,
			maximum
		)
		valueLabel.Text = string.format("%.1f", value)
		knob.Position = UDim2.new(
			(value - minimum) / (maximum - minimum), 0, 0.5, 0
		)
	end

	local function setFromX(x)
		if track.AbsoluteSize.X <= 0 then
			return
		end
		local fraction = math.clamp(
			(x - track.AbsolutePosition.X) / track.AbsoluteSize.X,
			0, 1
		)
		setValue(minimum + (maximum - minimum) * fraction)
	end

	local function beginDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
			setFromX(input.Position.X)
		end
	end

	connect(track.InputBegan, beginDrag)
	connect(bar.InputBegan, beginDrag)
	connect(knob.InputBegan, beginDrag)

	connect(UserInputService.InputChanged, function(input)
		if not dragInput then
			return
		end

		if input == dragInput
			or (
				dragInput.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseMovement
			) then
			setFromX(input.Position.X)
		end
	end)

	connect(UserInputService.InputEnded, function(input)
		if input == dragInput then
			dragInput = nil
		end
	end)

	setValue(default)

	return {
		GetValue = function()
			return value
		end,
		SetValue = setValue,
	}
end


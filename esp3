	}, data.Marker)

	data.MarkerText = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 2),
		Size = UDim2.fromOffset(220, 54),
		BackgroundTransparency = 1,
		TextColor3 = YELLOW,
		TextStrokeColor3 = BLACK,
		TextStrokeTransparency = 0.15,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 2,
	}, data.Marker)
end

connect(RunService.RenderStepped, function()
	if stopped then
		return
	end

	local camera = Workspace.CurrentCamera

	for player, data in pairs(records) do
		local shouldShow = specificEnabled
			and data.Specific
			and data.Position ~= nil
			and camera ~= nil

		if not shouldShow then
			if data.Marker then
				data.Marker.Visible = false
			end
			continue
		end

		local viewport = camera.ViewportSize
		if viewport.X < 1 or viewport.Y < 1 then
			if data.Marker then
				data.Marker.Visible = false
			end
			continue
		end

		ensureMarker(data)

		local available = data.Available
			and data.Character == player.Character
			and data.Part ~= nil
			and data.Part:IsDescendantOf(Workspace)

		local position = available and data.Part.Position or data.Position
		local center = viewport * 0.5
		local relative = camera.CFrame:PointToObjectSpace(position)
		local projected, onScreen = camera:WorldToViewportPoint(position)
		local behind = relative.Z >= 0

		local direction
		if behind then
			-- Camera-local coordinates avoid mirrored directions
			-- when a target is behind the camera.
			direction = Vector2.new(relative.X, -relative.Y)
		else
			direction = Vector2.new(projected.X, projected.Y) - center
		end

		if direction.Magnitude < 0.001 then
			direction = behind
				and Vector2.new(0, 1)
				or Vector2.new(0, -1)
		else
			direction = direction.Unit
		end

		-- Keep marker text inside the screen.
		local halfWidth = math.max(10, center.X - 120)
		local halfHeight = math.max(10, center.Y - 90)

		local edgeDistance = math.min(
			halfWidth / math.max(math.abs(direction.X), 0.0001),
			halfHeight / math.max(math.abs(direction.Y), 0.0001)
		)

		local screenPosition = center + direction * edgeDistance
		local rotation =
			math.deg(math.atan2(direction.Y, direction.X)) + 90

		if onScreen and not behind then
			-- On-screen: downward arrow just above the target.
			screenPosition = Vector2.new(
				math.clamp(
					projected.X,
					center.X - halfWidth,
					center.X + halfWidth
				),
				math.clamp(
					projected.Y - 36,
					center.Y - halfHeight,
					center.Y + halfHeight
				)
			)
			rotation = 180
		end

		local ownPart = positionPart(LocalPlayer.Character)
		local origin = ownPart and ownPart.Position or camera.CFrame.Position
		local distance = (position - origin).Magnitude

		local description
		if available then
			description = behind and "Behind camera" or "Replicated position"
		else
			description = string.format(
				"Last known: %ds ago%s",
				math.floor(os.clock() - (data.SeenAt or os.clock())),
				behind and " • Behind" or ""
			)
		end

		data.Marker.Position =
			UDim2.fromOffset(screenPosition.X, screenPosition.Y)
		data.Arrow.Rotation = rotation
		data.Arrow.TextTransparency = available and 0 or 0.2
		data.MarkerText.Text = string.format(
			"@%s • %s%.0f studs\n%s",
			player.Name,
			available and "" or "~",
			distance,
			description
		)
		data.Marker.Visible = true
	end
end)

---------------------------------------------------------------------
-- PERIODIC REPAIR / UPDATE
---------------------------------------------------------------------

local updateClock = 0
local visibilityCursor = 0

connect(RunService.Heartbeat, function(deltaTime)
	if stopped then
		return
	end

	updateClock += deltaTime
	if updateClock < UPDATE_INTERVAL then
		return
	end
	updateClock = 0

	local now = os.clock()
	local visibilityCandidates = {}
	local matched = 0
	local unavailable = 0
	local lastKnown = 0

	for player, data in pairs(records) do
		samplePlayer(player, data, now)

		if data.Wanted and data.Available then
			table.insert(visibilityCandidates, data)
		end

		if data.Specific then
			matched += 1
			if not data.Position then
				unavailable += 1
			elseif not data.Available then
				lastKnown += 1
			end
		end
	end

	-- Round-robin checks prevent later players from being starved
	-- when the server contains more than eight visible targets.
	local count = #visibilityCandidates
	if count > 0 then
		for _ = 1, math.min(MAX_VISIBILITY_CHECKS, count) do
			visibilityCursor = visibilityCursor % count + 1
			local data = visibilityCandidates[visibilityCursor]
			data.Visibility = visibleFraction(data.Character)
		end
	else
		visibilityCursor = 0
	end

	for player, data in pairs(records) do
		updateVisuals(player, data)
	end

	if not specificEnabled then
		targetStatus.Text = "Enable Specific outline to show target waypoints."
	elseif #specificNames() == 0 then
		targetStatus.Text = "Enter one or more target usernames above."
	elseif matched == 0 then
		targetStatus.Text = "No matching players in this server."
	else
		targetStatus.Text = string.format(
			"Targets: %d | Last known: %d | Position unavailable: %d",
			matched, lastKnown, unavailable
		)
	end
end)

---------------------------------------------------------------------
-- CLEANUP
---------------------------------------------------------------------

local function cleanupAll(destroyGui)
	if stopped then
		return
	end
	stopped = true

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)

	local playersToRemove = {}
	for player in pairs(records) do
		table.insert(playersToRemove, player)
	end
	for _, player in ipairs(playersToRemove) do
		removePlayer(player)
	end

	effectsFolder:Destroy()

	if destroyGui then
		screenGui:Destroy()
	end
end

connect(closeButton.Activated, function()
	cleanupAll(true)
end)

connect(cleanupEvent.Event, function()
	cleanupAll(true)
end)

connect(screenGui.Destroying, function()
	cleanupAll(false)
end)

connect(script.Destroying, function()
	cleanupAll(true)
end)


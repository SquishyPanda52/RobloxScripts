---------------------------------------------------------------------
-- TARGET MATCHING / PART LOOKUP
---------------------------------------------------------------------

local cachedText = nil
local cachedNames = {}

local function specificNames()
	local text = specificNamesBox.Text
	if text == cachedText then
		return cachedNames
	end

	cachedText = text
	cachedNames = {}

	for entry in text:gmatch("[^,]+") do
		local name = entry:match("^%s*(.-)%s*$")
		name = name:gsub("^@", ""):lower()
		if name ~= "" then
			table.insert(cachedNames, name)
		end
	end

	return cachedNames
end

local function isSpecific(player)
	local username = player.Name:lower()
	for _, name in ipairs(specificNames()) do
		if username:find(name, 1, true) then
			return true
		end
	end
	return false
end

local function partNamed(character, name)
	local part = character and character:FindFirstChild(name)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function positionPart(character)
	return partNamed(character, "HumanoidRootPart")
		or partNamed(character, "UpperTorso")
		or partNamed(character, "Torso")
		or partNamed(character, "Head")
end

local function teamColor(player)
	return player.Team and player.Team.TeamColor.Color or WHITE
end

---------------------------------------------------------------------
-- VISIBILITY
---------------------------------------------------------------------

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = false

local function visibleFraction(character)
	local camera = Workspace.CurrentCamera
	if not camera then
		return 1
	end

	local head = partNamed(character, "Head")
	local torso = partNamed(character, "UpperTorso")
		or partNamed(character, "Torso")
		or positionPart(character)

	local samples = {}
	if head then
		table.insert(samples, head)
	end
	if torso and torso ~= head then
		table.insert(samples, torso)
	end
	if #samples == 0 then
		return 0
	end

	rayParams.FilterDescendantsInstances =
		LocalPlayer.Character and { LocalPlayer.Character } or {}

	local clear = 0
	local origin = camera.CFrame.Position

	for _, part in ipairs(samples) do
		local direction = part.Position - origin
		if direction.Magnitude < 0.001 then
			clear += 1
		elseif direction.Magnitude <= 15000 then
			local hit = Workspace:Raycast(origin, direction, rayParams)
			if not hit or hit.Instance:IsDescendantOf(character) then
				clear += 1
			end
		end
	end

	return clear / #samples
end


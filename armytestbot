connect(Players.PlayerRemoving, function(player)
	watchedPlayerIds[player.UserId] = nil
	recentCommanderCommands[player.UserId] = nil
	if activeCommander == player or followTarget == player then
		cancelActiveCommand(false)
		clearNavigation()
	elseif commandMode == "Attack" then
		for index = #attackTargets, 1, -1 do
			if attackTargets[index] == player then
				table.remove(attackTargets, index)
			end
		end
		if attackTarget == player then
			attackTarget = nil
		end
		if #attackTargets == 0 then

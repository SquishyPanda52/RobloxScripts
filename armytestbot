local function stopSimulatedShiftlock()
	if aimUI.shiftOrientation then
		aimUI.shiftOrientation:Destroy()
	end
	if aimUI.shiftAttachment then
		aimUI.shiftAttachment:Destroy()
	end

	local humanoid = aimUI.shiftHumanoid
	if humanoid and humanoid.Parent then
		pcall(function()
			humanoid.AutoRotate = if aimUI.previousAutoRotate == nil
				then true
				else aimUI.previousAutoRotate
			humanoid.CameraOffset = aimUI.previousCameraOffset or Vector3.zero
		end)
	end

	aimUI.shiftHumanoid = nil
	aimUI.shiftRoot = nil
	aimUI.shiftOrientation = nil
	aimUI.shiftAttachment = nil
	aimUI.previousAutoRotate = nil
	aimUI.previousCameraOffset = nil
end

local function simulatedShiftlockStep()
	local active = not isClosed
		and aimSectionEnabled
		and shiftlockEnabled
		and (lockonEnabled or predictionEnabled)
	if not active then
		stopSimulatedShiftlock()
		return
	end

	local _, humanoid, root = getLivingCharacter(localPlayer)
	local camera = workspace.CurrentCamera
	if not humanoid or not root or not camera then
		stopSimulatedShiftlock()
		return
	end

	if aimUI.shiftHumanoid ~= humanoid
		or aimUI.shiftRoot ~= root
		or not aimUI.shiftOrientation
		or not aimUI.shiftOrientation.Parent then
		stopSimulatedShiftlock()
		aimUI.shiftHumanoid = humanoid
		aimUI.shiftRoot = root
		aimUI.previousAutoRotate = humanoid.AutoRotate
		aimUI.previousCameraOffset = humanoid.CameraOffset

		aimUI.shiftAttachment = Instance.new("Attachment")
		aimUI.shiftAttachment.Name = "BotsShiftlockAttachment"
		aimUI.shiftAttachment.Parent = root

		aimUI.shiftOrientation = Instance.new("AlignOrientation")
		aimUI.shiftOrientation.Name = "BotsShiftlockOrientation"
		aimUI.shiftOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
		aimUI.shiftOrientation.Attachment0 = aimUI.shiftAttachment
		aimUI.shiftOrientation.MaxTorque = 1000000
		aimUI.shiftOrientation.MaxAngularVelocity = math.huge
		aimUI.shiftOrientation.Responsiveness = 45
		aimUI.shiftOrientation.RigidityEnabled = false
		aimUI.shiftOrientation.Parent = root
	end

	humanoid.AutoRotate = false
	humanoid.CameraOffset = Vector3.new(1.75, 0, 0)

	local cameraLook = camera.CFrame.LookVector
	local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z)
	if flatLook.Magnitude > 0.001 then
		aimUI.shiftOrientation.CFrame = CFrame.lookAt(Vector3.zero, flatLook.Unit)
	end
end

local function aimCameraStep()
	if isClosed
		or not aimSectionEnabled
		or not (lockonEnabled or predictionEnabled) then
		if aimLastTargetRoot then
			resetAimLock()
		end
		simulatedShiftlockStep()
		return
	end

	local camera = workspace.CurrentCamera
	local targetRoot = currentAimTargetRoot()
	if not camera or not targetRoot then
		resetAimLock()
		simulatedShiftlockStep()
		return
	end

	local _, _, localRoot = getLivingCharacter(localPlayer)
	local targetPosition = targetRoot.Position
	if predictionEnabled and localRoot then
		local targetVelocity = targetRoot.AssemblyLinearVelocity
		local distance = (targetPosition - localRoot.Position).Magnitude
		local speed = targetVelocity.Magnitude
		local distanceFactor = math.clamp(distance / 60, 0, 2)
		local velocityFactor = math.clamp(speed / 20, 0, 2)
		local predictionTime = predictionStrength
			* (0.5 + 0.5 * distanceFactor + 0.5 * velocityFactor)
		targetPosition += targetVelocity * predictionTime
	end

	local desiredCFrame = CFrame.lookAt(camera.CFrame.Position, targetPosition)
	if aimLastTargetRoot ~= targetRoot then
		aimLastTargetRoot = targetRoot
		if snapEnabled then
			aimTransitionActive = false
			camera.CFrame = desiredCFrame
		else
			aimTransitionActive = true
			aimTransitionFrom = camera.CFrame
			aimTransitionStartedAt = os.clock()
		end
	end

	if aimTransitionActive and aimTransitionFrom then
		local alpha = math.clamp((os.clock() - aimTransitionStartedAt) / 0.12, 0, 1)
		local easedAlpha = 1 - (1 - alpha) * (1 - alpha)
		camera.CFrame = aimTransitionFrom:Lerp(desiredCFrame, easedAlpha)
		if alpha >= 1 then
			aimTransitionActive = false
			aimTransitionFrom = nil
		end
	else
		camera.CFrame = desiredCFrame
	end

	simulatedShiftlockStep()
end


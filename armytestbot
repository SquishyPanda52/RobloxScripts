	aimUI.resetAttackSafety()
	setFollowEnabled(false)
	setAttackEnabled(true)
	activeCommander = player
	followTarget = nil
	attackTargets = targets
	attackTarget = targets[1]
	commandMode = "Attack"
	holdPosition = nil
	localWasUnavailable = false
	commanderWasUnavailable = false
	targetWasUnavailable = false
	lastAttackAt = 0
	pickedTool = nil

	if savedText and trim(savedText) ~= "" then
		suppressAttackBoxUpdate = true
		attackBox.Text = trim(savedText)
		suppressAttackBoxUpdate = false
		attackBox.TextColor3 = Color3.fromRGB(240, 241, 245)
		aimUI.attackValidationShowingError = false
		task.defer(updateResults)
	end
end

local function closestLivingAttackTarget(localPosition)
	local closestPlayer
	local closestRoot
	local closestDistance = math.huge
	local hasWaitingTarget = false

	for index = #attackTargets, 1, -1 do
		local player = attackTargets[index]
		if not player
			or player == localPlayer
			or not player.Parent
			or aimUI.isProtectedPlayer(player) then
			table.remove(attackTargets, index)
		else
			local _, _, root = getLivingCharacter(player)
			if root then
				local distance = (localPosition - root.Position).Magnitude
				if distance < closestDistance then
					closestDistance = distance
					closestPlayer = player
					closestRoot = root
				end
			elseif deathAttackEnabled then
				hasWaitingTarget = true
			else
				table.remove(attackTargets, index)
			end
		end
	end

	return closestPlayer, closestRoot, hasWaitingTarget
end

local function selectedTool(character)
	if not toolPickerEnabled then
		return character and character:FindFirstChildOfClass("Tool")
	end

	if pickedTool and pickedTool.Parent then
		return pickedTool
	end

	local index = tonumber(trim(toolPickerBox.Text))
	if not index then
		return nil
	end
	index = math.max(1, math.floor(index))

	local tools = {}
	local equipped = character and character:FindFirstChildOfClass("Tool")
	if equipped then
		table.insert(tools, equipped)
	end

	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, item in backpack:GetChildren() do
			if item:IsA("Tool") and item ~= equipped then
				table.insert(tools, item)
			end
		end
	end

	pickedTool = tools[index]
	return pickedTool
end

local function activateAttackTool(character, humanoid)
	local tool = selectedTool(character)
	if toolPickerEnabled and tool and tool.Parent ~= character then
		humanoid:EquipTool(tool)
	end

	local equipped = character:FindFirstChildOfClass("Tool")
	if not equipped then
		return
	end

	local now = os.clock()
	if now - lastAttackAt >= ATTACK_CLICK_INTERVAL then
		lastAttackAt = now
		pcall(function()
			equipped:Activate()
		end)
	end
end

local function commandShouldSurviveDeath()
	if commandMode == "Attack" then
		return deathAttackEnabled
	end
	return deathFollowEnabled
end

local function followPlanStep()
	if commandMode == "None" then
		return
	end
	if (commandMode == "Attack" and not attackEnabled)
		or (commandMode ~= "Attack" and not followEnabled) then
		cancelActiveCommand(false)
		return
	end

	if activeCommander
		and (activeCommander == localPlayer
			or not activeCommander.Parent
			or not selectedCommanderIds[activeCommander.UserId]) then
		cancelActiveCommand(false)
		return
	end

	local localCharacter, localHumanoid, localRoot = getLivingCharacter(localPlayer)
	if not localHumanoid or not localRoot then
		localWasUnavailable = true
		stopActiveMovement()
		if not commandShouldSurviveDeath() then
			cancelActiveCommand(false)
		end
		return
	end

	if localWasUnavailable then
		localWasUnavailable = false
		lastIssuedMoveTarget = nil
		lastMoveIssuedAt = 0
		pickedTool = nil
	end

	local destination

	if commandMode == "Follow" then
		if not followTarget or followTarget == localPlayer or not followTarget.Parent then
			cancelActiveCommand(false)
			return
		end

		local _, _, followedRoot = getLivingCharacter(followTarget)
		if not followedRoot then
			commanderWasUnavailable = true
			stopActiveMovement()
			if not deathFollowEnabled then
				cancelActiveCommand(false)
			end
			return
		end

		if commanderWasUnavailable then
			commanderWasUnavailable = false
			lastIssuedMoveTarget = nil
			lastMoveIssuedAt = 0
		end

		local followedDistance = (localRoot.Position - followedRoot.Position).Magnitude
		if followedDistance <= FOLLOW_STOP_DISTANCE then
			stopActiveMovement()
			return
		end
		if followedDistance < FOLLOW_RESUME_DISTANCE and not followMovementActive then
			return
		end

		destination = desiredStandPosition(followedRoot)
	elseif commandMode == "Hold" then
		if not holdPosition then
			cancelActiveCommand(false)
			return
		end

		local holdDistance = (localRoot.Position - holdPosition).Magnitude
		if holdDistance <= HOLD_STOP_DISTANCE then
			stopActiveMovement()
			return
		end

		destination = holdPosition
	elseif commandMode == "Attack" then
		local closestPlayer, targetRoot, hasWaitingTarget = closestLivingAttackTarget(localRoot.Position)
		if not closestPlayer or not targetRoot then
			attackTarget = nil
			targetWasUnavailable = hasWaitingTarget
			stopActiveMovement()
			if not hasWaitingTarget then
				cancelActiveCommand(false)
			end
			return
		end

		attackTarget = closestPlayer
		if targetWasUnavailable then
			targetWasUnavailable = false
			lastIssuedMoveTarget = nil
			lastMoveIssuedAt = 0
		end

		local safetyMode, safetyDestination =
			aimUI.attackSafetyAction(closestPlayer, targetRoot, localRoot)
		if safetyMode ~= "Chase" then
			local equippedTool = localCharacter:FindFirstChildOfClass("Tool")
			if equippedTool then
				pcall(function()
					equippedTool:Deactivate()
				end)
			end
		end

		if safetyMode == "Pause" then
			stopActiveMovement()
			return
		elseif safetyMode == "Retreat" then
			destination = safetyDestination
		else
			destination = targetRoot.Position
			activateAttackTool(localCharacter, localHumanoid)
		end
	else
		cancelActiveCommand(false)
		return
	end

	followMovementActive = true
	activeMoveTarget = destination
	issueMoveTo(localHumanoid, destination, false)
end

local recentCommanderCommands = {}

local function handleCommanderMessage(player, message)
	if isClosed or player == localPlayer then
		return
	end
	if not selectedCommanderIds[player.UserId] then
		return
	end

	local normalized = string.lower(trim(message))
	normalized = string.gsub(normalized, "^/e%s+", "")

	local now = os.clock()
	local previous = recentCommanderCommands[player.UserId]
	if previous and previous.text == normalized and now - previous.time < 0.3 then
		return
	end

	local quickFollowCommand = normalized == "c" or normalized == "f"
	local helpCommand = normalized == "help" or normalized == "h"
	local teamAssistOnCommand = normalized == "team assist"
		or normalized == "help teammates"
	local teamAssistOffCommand = normalized == "no team assist"
		or normalized == "no help teammates"
	local settingCommand = normalized == "death follow"
		or normalized == "no death follow"
		or normalized == "death attack"
		or normalized == "no death attack"
		or teamAssistOnCommand
		or teamAssistOffCommand
		or helpCommand
	local command, targetText = string.match(normalized, "^(%a+)%s*(.-)%s*$")
	local recognized = settingCommand
		or quickFollowCommand
		or command == "follow"
		or command == "come"
		or command == "goto"
		or command == "hold"
		or command == "stop"
		or command == "clear"
		or command == "atk"
		or command == "attack"
	if not recognized then
		return
	end

	recentCommanderCommands[player.UserId] = {
		text = normalized,
		time = now,
	}

	if helpCommand then
		aimUI.attackSafetyOverrideUntil = os.clock() + 30
		aimUI.resetAttackSafety()
		screenGui:SetAttribute("AttackSafetyState", "HelpOverride")
		screenGui:SetAttribute("AttackSafetyOverrideRemaining", 30)
	elseif quickFollowCommand then
		beginFollowCommand(player, player, nil)
	elseif teamAssistOnCommand then
		aimUI.teamAssistEnabled = true
		updateToggleVisual(
			aimUI.teamAssistButton,
			aimUI.teamAssistStroke,
			"Team Assist",
			true
		)
	elseif teamAssistOffCommand then
		aimUI.teamAssistEnabled = false
		updateToggleVisual(
			aimUI.teamAssistButton,
			aimUI.teamAssistStroke,
			"Team Assist",
			false
		)
	elseif normalized == "death follow" then
		deathFollowEnabled = true
		updateToggleVisual(deathFollowButton, deathFollowStroke, "Death Follow", true)
	elseif normalized == "no death follow" then
		deathFollowEnabled = false
		updateToggleVisual(deathFollowButton, deathFollowStroke, "Death Follow", false)
	elseif normalized == "death attack" then
		deathAttackEnabled = true
		updateToggleVisual(deathAttackButton, deathAttackStroke, "Death Attack", true)
	elseif normalized == "no death attack" then
		deathAttackEnabled = false
		updateToggleVisual(deathAttackButton, deathAttackStroke, "Death Attack", false)
	elseif command == "stop" then
		cancelActiveCommand(true)
	elseif command == "clear" then
		suppressAttackBoxUpdate = true
		attackBox.Text = ""
		suppressAttackBoxUpdate = false
		attackBox.TextColor3 = Color3.fromRGB(240, 241, 245)
		aimUI.attackValidationShowingError = false
		task.defer(updateResults)
		if commandMode == "Attack" then
			cancelActiveCommand(false)
		end
	elseif command == "hold" then
		local _, _, commanderRoot = getLivingCharacter(player)
		if commanderRoot then
			beginCommanderCommand(player, "Hold", commanderRoot.Position)
		end
	elseif command == "atk" or command == "attack" then
		local requestedText = if trim(targetText) ~= "" then targetText else attackBox.Text
		local targets, blocked = resolveAttackTargets(requestedText, player, false)
		local usingSavedTargets = trim(targetText) == ""
		if #targets > 0 and not (usingSavedTargets and #blocked > 0) then
			local savedText
			if not usingSavedTargets then
				local allowedNames = {}
				for _, target in targets do
					table.insert(allowedNames, target.Name)
				end
				savedText = table.concat(allowedNames, ", ")
			end
			beginAttackCommand(player, targets, savedText)
		else
			cancelActiveCommand(false)
			setFollowEnabled(false)
			setAttackEnabled(#blocked == 0)
			if #blocked > 0 then
				results.Text = "ERROR: Protected commanders or teammates cannot be attacked."
				results.TextColor3 = Color3.fromRGB(255, 105, 116)
			end
		end
	elseif command == "follow" then
		if trim(targetText) == "" then
			beginFollowCommand(player, player, nil)
		else
			local targets = resolveAttackTargets(targetText, player, true)
			if targets[1] then
				beginFollowCommand(player, targets[1], targetText)
			end
		end
	else
		beginFollowCommand(player, player, nil)
	end
end

local watchedPlayerIds = {}

local function watchPlayerChat(player)
	if watchedPlayerIds[player.UserId] then
		return
	end
	watchedPlayerIds[player.UserId] = true
	connect(player.Chatted, function(message)
		handleCommanderMessage(player, message)

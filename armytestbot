local function setMinimized(minimized)
	if isClosed then
		return
	end

	if minimized then
		tabHasMoved = windowHasMoved
		minimizedTab.Position = if tabHasMoved
			then clampPosition(minimizedTab, window.Position)
			else UDim2.fromScale(0.5, 0.5)
		window.Visible = false
		minimizedTab.Visible = true
	else
		windowHasMoved = tabHasMoved
		window.Position = if windowHasMoved
			then clampPosition(window, minimizedTab.Position)
			else UDim2.fromScale(0.5, 0.5)
		minimizedTab.Visible = false
		window.Visible = true
	end
end

openMinimizedTab = function()
	setMinimized(false)
end

local function closeRuntime()
	if isClosed then
		return
	end

	isClosed = true
	updateSerial += 1
	cancelActiveCommand(true)
	clearNavigation()
	stopSimulatedShiftlock()
	screenGui.Enabled = false

	for _, connection in runtimeConnections do
		connection:Disconnect()
	end
	table.clear(runtimeConnections)

	screenGui:Destroy()
	script:Destroy()
end


local function clampPosition(target, position)
	local camera = workspace.CurrentCamera
	if not camera then
		return position
	end

	local viewport = camera.ViewportSize
	local targetSize = target.AbsoluteSize
	if targetSize.X <= 0 or targetSize.Y <= 0 then
		targetSize = Vector2.new(target.Size.X.Offset, target.Size.Y.Offset)
	end

	local desiredX = viewport.X * position.X.Scale + position.X.Offset
	local desiredY = viewport.Y * position.Y.Scale + position.Y.Offset
	local halfWidth = targetSize.X * target.AnchorPoint.X
	local halfHeight = targetSize.Y * target.AnchorPoint.Y
	local rightSpace = targetSize.X * (1 - target.AnchorPoint.X)
	local bottomSpace = targetSize.Y * (1 - target.AnchorPoint.Y)
	local margin = 6

	local minX = halfWidth + margin
	local maxX = math.max(minX, viewport.X - rightSpace - margin)
	local minY = halfHeight + margin
	local maxY = math.max(minY, viewport.Y - bottomSpace - margin)

	return UDim2.fromOffset(
		math.clamp(desiredX, minX, maxX),
		math.clamp(desiredY, minY, maxY)
	)
end

local windowHasMoved = false
local tabHasMoved = false

local function makeDraggable(handle, target, onDragged, onClicked)
	local dragging = false
	local pointerInput
	local dragInput
	local dragStart = Vector3.zero
	local startPosition = target.Position
	local moved = false
	local lastDraggedAt = -math.huge

	connect(handle.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		dragging = true
		pointerInput = input
		dragStart = input.Position
		startPosition = target.Position
		moved = false
	end)

	connect(handle.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end

		local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
		local isActiveTouch = input.UserInputType == Enum.UserInputType.Touch and input == pointerInput
		if not isMouseMove and not isActiveTouch then
			return
		end

		local delta = input.Position - dragStart
		if delta.Magnitude >= 4 and not moved then
			moved = true
			lastDraggedAt = os.clock()
			onDragged()
		end

		local nextPosition = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
		target.Position = clampPosition(target, nextPosition)
	end)

	connect(UserInputService.InputEnded, function(input)
		if input ~= pointerInput then
			return
		end

		local didMove = moved or target.Position ~= startPosition
		dragging = false
		pointerInput = nil
		dragInput = nil
		if didMove then
			lastDraggedAt = os.clock()
		elseif onClicked then
			onClicked()
		end
	end)
end


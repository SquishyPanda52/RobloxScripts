local MAX_MELEE_LOG_DISTANCE = 8

local watchedLocalHumanoid
local localHealthConnection
local lastLocalHealth

local function distanceFromCharacter(character, player)
	local localRoot = character and character:FindFirstChild("HumanoidRootPart")
	local _, _, otherRoot = getLivingCharacter(player)
	if not localRoot or not otherRoot then
		return math.huge
	end
	return (localRoot.Position - otherRoot.Position).Magnitude
end

local function isExtremelyClose(character, player)
	return player ~= nil
		and player ~= localPlayer
		and distanceFromCharacter(character, player) <= MAX_MELEE_LOG_DISTANCE
end

local function taggedAttacker(humanoid, character, victimPlayer)
	for _, tagName in { "creator", "Creator" } do
		local tag = humanoid:FindFirstChild(tagName)
		if tag and tag:IsA("ObjectValue") then
			local value = tag.Value
			local player
			if value and value:IsA("Player") then
				player = value
			elseif value and value:IsA("Model") then
				player = Players:GetPlayerFromCharacter(value)
			end

			if player then
				if player == localPlayer or player == victimPlayer then
					return nil, true
				end
				if aimUI.isProtectedPlayer(player) then
					return nil, true
				end
				if isExtremelyClose(character, player) then
					return player, true
				end
				return nil, true
			end
		end
	end
	return nil, false
end

local function closestPlayerWhenDamaged(character, victimPlayer)
	local closestPlayer
	local closestDistance = MAX_MELEE_LOG_DISTANCE
	for _, player in Players:GetPlayers() do
		if player ~= localPlayer
			and player ~= victimPlayer
			and not aimUI.isProtectedPlayer(player) then
			local distance = distanceFromCharacter(character, player)
			if distance <= closestDistance then
				closestDistance = distance
				closestPlayer = player
			end
		end
	end

	return closestPlayer
end

local function addDamageAttacker(player)
	if not player or player == localPlayer or aimUI.isProtectedPlayer(player) then
		return
	end

	local _, validAttackText = aimUI.validateAttackBox(true)
	if not validAttackText then
		return
	end

	local savedTargets = resolveAttackTargets(attackBox.Text, nil)
	local alreadySaved = false
	for _, savedPlayer in savedTargets do
		if savedPlayer == player then
			alreadySaved = true
			break
		end
	end

	if not alreadySaved then
		local previousText = trim(attackBox.Text)
		suppressAttackBoxUpdate = true
		attackBox.Text = if previousText == ""
			then player.Name
			else previousText .. ", " .. player.Name
		suppressAttackBoxUpdate = false
	end

	local activePoolContainsPlayer = false
	for _, activeTarget in attackTargets do
		if activeTarget == player then
			activePoolContainsPlayer = true
			break
		end
	end

	local targets = resolveAttackTargets(attackBox.Text, nil)
	if #targets == 0 then
		return
	end

	if commandMode ~= "Attack" or not attackEnabled or not activePoolContainsPlayer then
		beginAttackCommand(nil, targets, nil)
	end
end

local function watchLocalDamage(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or humanoid == watchedLocalHumanoid then
		return
	end

	if localHealthConnection then
		localHealthConnection:Disconnect()
		localHealthConnection = nil
	end

	watchedLocalHumanoid = humanoid
	lastLocalHealth = humanoid.Health
	localHealthConnection = connect(humanoid.HealthChanged, function(newHealth)
		local previousHealth = lastLocalHealth
		lastLocalHealth = newHealth
		if previousHealth == nil then
			return
		end

		local damageAmount = previousHealth - newHealth
		if damageAmount <= 0 then
			return
		end

		screenGui:SetAttribute("LastDamageAmount", damageAmount)
		screenGui:SetAttribute("HealthAfterDamage", newHealth)

		local attacker, hadAttackerTag =
			taggedAttacker(humanoid, character, localPlayer)
		if not hadAttackerTag then
			attacker = closestPlayerWhenDamaged(character, localPlayer)
		end
		if attacker then
			screenGui:SetAttribute("LastMeleeAttacker", attacker.Name)
			addDamageAttacker(attacker)
		end
	end)
end


local function applyResponsiveLayout()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local viewport = camera.ViewportSize
	local isPortrait = viewport.Y > viewport.X
	local shortSide = math.min(viewport.X, viewport.Y)
	local compactScale = math.clamp(shortSide / 520, 0.82, 1)

	local targetWidth = viewport.X * (if isPortrait then 0.9 else 0.54)
	local targetHeight = viewport.Y * (if isPortrait then 0.38 else 0.68)

	targetWidth = math.clamp(targetWidth, 250, 520)
	targetHeight = math.clamp(targetHeight, 190, 360)
	targetWidth = math.min(targetWidth, math.max(viewport.X - 24, 220))
	targetHeight = math.min(targetHeight, math.max(viewport.Y - 24, 170))

	window.Size = UDim2.fromOffset(math.floor(targetWidth), math.floor(targetHeight))

	local headerHeight = math.max(40, math.floor(44 * compactScale))
	local controlSize = math.max(28, math.floor(30 * compactScale))
	topBar.Size = UDim2.new(1, 0, 0, headerHeight)
	brand.TextSize = math.max(13, math.floor(15 * compactScale))
	minimizeButton.Size = UDim2.fromOffset(controlSize, controlSize)
	closeButton.Size = UDim2.fromOffset(controlSize, controlSize)
	scrollingFrame.Position = UDim2.fromOffset(0, headerHeight)
	scrollingFrame.Size = UDim2.new(1, 0, 1, -headerHeight)
	scrollingFrame.ScrollBarThickness = math.max(3, math.floor(5 * compactScale))
	minimizedTab.Size = UDim2.fromOffset(
		math.max(108, math.floor(124 * compactScale)),
		math.max(40, math.floor(44 * compactScale))
	)
	minimizedTab.TextSize = math.max(13, math.floor(15 * compactScale))

	local outerPadding = math.floor(18 * compactScale)
	padding.PaddingTop = UDim.new(0, outerPadding)
	padding.PaddingBottom = UDim.new(0, outerPadding)
	padding.PaddingLeft = UDim.new(0, outerPadding)
	padding.PaddingRight = UDim.new(0, outerPadding)
	listLayout.Padding = UDim.new(0, math.floor(12 * compactScale))

	local inputHeight = math.max(48, math.floor(54 * compactScale))
	if targetWidth >= 420 then
		aimUI.commanderArea.Size = UDim2.new(1, 0, 0, math.max(56, math.floor(62 * compactScale)))
		commandBox.Position = UDim2.fromScale(0, 0)
		commandBox.Size = UDim2.new(0.54, -8, 1, 0)
		aimUI.noFriendlyFireButton.Position = UDim2.new(0.54, 0, 0, 0)
		aimUI.noFriendlyFireButton.Size = UDim2.new(0.22, -5, 1, 0)
		aimUI.noFriendlyFireDescription.Position = UDim2.new(0.76, 3, 0, 0)
		aimUI.noFriendlyFireDescription.Size = UDim2.new(0.24, -3, 1, 0)
	else
		aimUI.commanderArea.Size = UDim2.new(1, 0, 0, inputHeight + math.max(38, math.floor(42 * compactScale)) + 8)
		commandBox.Position = UDim2.fromScale(0, 0)
		commandBox.Size = UDim2.new(1, 0, 0, inputHeight)
		aimUI.noFriendlyFireButton.Position = UDim2.new(0, 0, 0, inputHeight + 8)
		aimUI.noFriendlyFireButton.Size = UDim2.new(0.46, -4, 0, math.max(38, math.floor(42 * compactScale)))
		aimUI.noFriendlyFireDescription.Position = UDim2.new(0.46, 4, 0, inputHeight + 8)
		aimUI.noFriendlyFireDescription.Size = UDim2.new(0.54, -4, 0, math.max(38, math.floor(42 * compactScale)))
	end
	commandBox.TextSize = math.max(13, math.floor(15 * compactScale))
	boxPadding.PaddingLeft = UDim.new(0, math.floor(16 * compactScale))
	boxPadding.PaddingRight = UDim.new(0, math.floor(16 * compactScale))
	aimUI.noFriendlyFireDescription.TextSize = math.max(8, math.floor(9 * compactScale))
	aimUI.teamArea.Size = UDim2.new(1, 0, 0, inputHeight)
	aimUI.teamBox.Position = UDim2.fromScale(0, 0)
	aimUI.teamBox.Size = UDim2.new(0.7, -5, 1, 0)
	aimUI.teamAssistButton.Position = UDim2.new(0.7, 5, 0, 0)
	aimUI.teamAssistButton.Size = UDim2.new(0.3, -5, 1, 0)
	aimUI.teamBox.TextSize = math.max(13, math.floor(15 * compactScale))
	aimUI.teamBoxPadding.PaddingLeft = UDim.new(0, math.floor(16 * compactScale))
	aimUI.teamBoxPadding.PaddingRight = UDim.new(0, math.floor(16 * compactScale))
	followBox.Size = UDim2.new(1, 0, 0, inputHeight)
	followBox.TextSize = math.max(13, math.floor(15 * compactScale))
	followBoxPadding.PaddingLeft = UDim.new(0, math.floor(16 * compactScale))
	followBoxPadding.PaddingRight = UDim.new(0, math.floor(16 * compactScale))
	toggleRow.Size = UDim2.new(1, 0, 0, math.max(44, math.floor(48 * compactScale)))
	toggleLayout.Padding = UDim.new(0, math.max(8, math.floor(10 * compactScale)))
	attackBox.Size = UDim2.new(1, 0, 0, math.max(48, math.floor(54 * compactScale)))
	attackBox.TextSize = math.max(13, math.floor(15 * compactScale))
	attackBoxPadding.PaddingLeft = UDim.new(0, math.floor(16 * compactScale))
	attackBoxPadding.PaddingRight = UDim.new(0, math.floor(16 * compactScale))

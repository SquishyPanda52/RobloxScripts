	local _, humanoid = getLivingCharacter(localPlayer)
	if humanoid then
		humanoid:UnequipTools()
	end
end

local function setFollowEnabled(enabled)
	followEnabled = enabled
	updateToggleVisual(followButton, followStroke, "Follow", enabled)
end

local function setAttackEnabled(enabled)

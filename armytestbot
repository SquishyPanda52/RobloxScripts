local function trim(value)
	return string.match(value, "^%s*(.-)%s*$") or ""
end

local function resolvePlayers(text)
	local resolved = {}
	local seenUserIds = {}
	local messages = {}

	for entry in string.gmatch(text, "[^,]+") do
		local query = string.lower(trim(entry))
		if query ~= "" then
			local matches = {}

			for _, player in Players:GetPlayers() do
				local username = string.lower(player.Name)
				local displayName = string.lower(player.DisplayName)

				if string.find(username, query, 1, true)
					or string.find(displayName, query, 1, true) then
					table.insert(matches, player)
				end
			end

			table.sort(matches, function(a, b)
				local aExact = string.lower(a.Name) == query or string.lower(a.DisplayName) == query
				local bExact = string.lower(b.Name) == query or string.lower(b.DisplayName) == query
				if aExact ~= bExact then
					return aExact
				end
				return a.Name:lower() < b.Name:lower()
			end)

			if #matches == 0 then
				table.insert(messages, string.format("“%s” → no match", trim(entry)))
			else
				local names = {}
				for _, player in matches do
					table.insert(names, string.format("%s (@%s)", player.DisplayName, player.Name))
					if not seenUserIds[player.UserId] then
						seenUserIds[player.UserId] = true
						table.insert(resolved, player)
					end
				end
				table.insert(messages, string.format("“%s” → %s", trim(entry), table.concat(names, ", ")))
			end
		end
	end

	return resolved, messages
end

aimUI.isProtectedPlayer = function(player)
	if not player or player == localPlayer then
		return false
	end
	if aimUI.teamPlayerIds[player.UserId] then
		return true
	end
	return aimUI.noFriendlyFireEnabled and selectedCommanderIds[player.UserId] == true
end

aimUI.updateTeamList = function()
	local resolved = select(1, resolvePlayers(aimUI.teamBox.Text))
	table.clear(aimUI.teamPlayerIds)
	for _, player in resolved do
		if player ~= localPlayer then
			aimUI.teamPlayerIds[player.UserId] = true
		end
	end

	local hasText = trim(aimUI.teamBox.Text) ~= ""
	aimUI.teamBox.TextColor3 = if not hasText or #resolved > 0
		then Color3.fromRGB(240, 241, 245)
		else Color3.fromRGB(255, 118, 128)

	if aimUI.validateAttackBox then
		aimUI.validateAttackBox(true)
	end
end

local cancelActiveCommand
local updateSerial = 0

local function updateResults()
	updateSerial += 1
	local thisUpdate = updateSerial

	task.delay(0.12, function()
		if isClosed or thisUpdate ~= updateSerial then
			return
		end

		if trim(commandBox.Text) == "" then
			table.clear(selectedCommanders)
			table.clear(selectedCommanderIds)
			if activeCommander and cancelActiveCommand then
				cancelActiveCommand(false)
			end
			results.Text = "Waiting for player names..."
			results.TextColor3 = Color3.fromRGB(190, 192, 202)
			if aimUI.validateAttackBox then
				aimUI.validateAttackBox(true)
			end
			return
		end

		local resolved, messages = resolvePlayers(commandBox.Text)
		selectedCommanders = resolved
		table.clear(selectedCommanderIds)
		for _, player in resolved do
			selectedCommanderIds[player.UserId] = true
		end

		if activeCommander and not selectedCommanderIds[activeCommander.UserId] then
			cancelActiveCommand(false)
		end

		results.Text = table.concat(messages, "\n")
		results.TextColor3 = if #resolved > 0
			then Color3.fromRGB(185, 225, 197)
			else Color3.fromRGB(235, 160, 160)
		if aimUI.validateAttackBox then
			aimUI.validateAttackBox(true)
		end
	end)
end

local FOLLOW_STOP_DISTANCE = 5.5
local FOLLOW_RESUME_DISTANCE = 7
local FOLLOW_OFFSET_DISTANCE = 5
local HOLD_STOP_DISTANCE = 2.5
local MOVE_KEEPALIVE = 0.2
local MOVE_TARGET_EPSILON = 0.75
local ATTACK_CLICK_INTERVAL = 0.12

local function desiredStandPosition(commanderRoot)
	local lookVector = commanderRoot.CFrame.LookVector
	local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
	if flatLook.Magnitude < 0.1 then
		flatLook = Vector3.new(0, 0, -1)
	end

	return commanderRoot.Position - flatLook.Unit * FOLLOW_OFFSET_DISTANCE
end

local function resolveAttackTargets(text, commander, allowProtected)
	local resolved = {}
	local blocked = {}
	local seenUserIds = {}
	local seenBlockedIds = {}

	local function considerPlayer(player)
		if aimUI.isProtectedPlayer(player) and not allowProtected then
			if not seenBlockedIds[player.UserId] then
				seenBlockedIds[player.UserId] = true
				table.insert(blocked, player)
			end
		elseif not seenUserIds[player.UserId] then
			seenUserIds[player.UserId] = true
			table.insert(resolved, player)
		end
	end

	for entry in string.gmatch(text, "[^,]+") do
		local query = string.lower(trim(entry))
		query = string.gsub(query, "^@", "")
		if query ~= "" then
			if query == "me" and commander and commander ~= localPlayer then
				considerPlayer(commander)
			else
				local matches = {}
				for _, player in Players:GetPlayers() do
					if player ~= localPlayer then
						local username = string.lower(player.Name)
						local displayName = string.lower(player.DisplayName)
						if string.find(username, query, 1, true)
							or string.find(displayName, query, 1, true) then
							table.insert(matches, player)
						end
					end
				end

				table.sort(matches, function(a, b)
					local aExact = string.lower(a.Name) == query or string.lower(a.DisplayName) == query
					local bExact = string.lower(b.Name) == query or string.lower(b.DisplayName) == query
					if aExact ~= bExact then
						return aExact
					end
					return a.Name:lower() < b.Name:lower()
				end)

				for _, player in matches do
					considerPlayer(player)
				end
			end
		end
	end

	return resolved, blocked
end

aimUI.validateAttackBox = function(showError)
	local targets, blocked = resolveAttackTargets(attackBox.Text, nil, false)
	if #blocked > 0 then
		local blockedCommander = false
		local blockedTeammate = false
		for _, player in blocked do
			blockedCommander = blockedCommander
				or (aimUI.noFriendlyFireEnabled and selectedCommanderIds[player.UserId] == true)
			blockedTeammate = blockedTeammate or aimUI.teamPlayerIds[player.UserId] == true
		end

		local protectedType = if blockedCommander and blockedTeammate
			then "a protected commander or teammate"
			elseif blockedCommander then "a commander's user"
			else "a teammate"
		attackBox.TextColor3 = Color3.fromRGB(255, 105, 116)
		aimUI.attackValidationShowingError = true
		if showError then
			results.Text = "ERROR: Cannot execute attack because " .. protectedType .. " is in the Attack Textbox."
			results.TextColor3 = Color3.fromRGB(255, 105, 116)
		end
		return targets, false, blocked
	end

	attackBox.TextColor3 = Color3.fromRGB(240, 241, 245)
	if aimUI.attackValidationShowingError then
		aimUI.attackValidationShowingError = false
		task.defer(updateResults)
	end
	return targets, true, blocked
end

aimUI.resetAttackSafety = function()
	aimUI.attackSafetyPaused = false
	aimUI.attackSafetyTargetUserId = nil
	aimUI.attackSafetyFriendlyUserId = nil
	aimUI.attackRetreatIssued = false
	aimUI.attackRetreatPosition = nil
	screenGui:SetAttribute("AttackSafetyState", "Idle")
end

aimUI.attackSafetyAction = function(targetPlayer, targetRoot, localRoot)
	local overrideRemaining = math.max(0, aimUI.attackSafetyOverrideUntil - os.clock())
	screenGui:SetAttribute("AttackSafetyOverrideRemaining", overrideRemaining)
	if overrideRemaining > 0 then
		aimUI.attackSafetyPaused = false
		aimUI.attackSafetyTargetUserId = targetPlayer.UserId
		aimUI.attackSafetyFriendlyUserId = nil
		aimUI.attackRetreatIssued = false
		aimUI.attackRetreatPosition = nil
		screenGui:SetAttribute("AttackSafetyState", "HelpOverride")
		return "Chase", targetRoot.Position
	end

	if aimUI.attackSafetyTargetUserId ~= targetPlayer.UserId then
		aimUI.resetAttackSafety()
		aimUI.attackSafetyTargetUserId = targetPlayer.UserId
	end

	local targetPosition = targetRoot.Position
	local localPosition = localRoot.Position
	local chaseVector = targetPosition - localPosition
	local flatChase = Vector3.new(chaseVector.X, 0, chaseVector.Z)
	local hazardPlayer
	local hazardRoot
	local hazardTargetDistance = math.huge

	for _, player in Players:GetPlayers() do
		if aimUI.isProtectedPlayer(player) then
			local _, _, protectedRoot = getLivingCharacter(player)
			if protectedRoot then
				local targetDistance = (protectedRoot.Position - targetPosition).Magnitude
				local inChaseCorridor = false
				local corridorDistance = math.huge

				if flatChase.Magnitude > 0.05 then
					local toFriendly = protectedRoot.Position - localPosition
					local flatToFriendly = Vector3.new(toFriendly.X, 0, toFriendly.Z)
					local along = flatToFriendly:Dot(flatChase) / flatChase:Dot(flatChase)
					if along > 0 and along < 1 then
						local closestPoint = localPosition + flatChase * along
						local corridorOffset = protectedRoot.Position - closestPoint
						corridorDistance = Vector3.new(
							corridorOffset.X,
							0,
							corridorOffset.Z
						).Magnitude
						inChaseCorridor = true
					end
				end

				local unsafe = if aimUI.attackSafetyPaused
					then targetDistance < aimUI.attackFriendlyResumeDistance
					or (inChaseCorridor
						and corridorDistance < aimUI.attackFriendlyResumeCorridor)
					else targetDistance <= aimUI.attackFriendlyPauseDistance
					or (inChaseCorridor
						and corridorDistance <= aimUI.attackFriendlyCorridorDistance)

				if unsafe and targetDistance < hazardTargetDistance then
					hazardPlayer = player
					hazardRoot = protectedRoot
					hazardTargetDistance = targetDistance
				end
			end
		end
	end

	if not hazardPlayer or not hazardRoot then
		aimUI.resetAttackSafety()
		aimUI.attackSafetyTargetUserId = targetPlayer.UserId
		screenGui:SetAttribute("AttackSafetyState", "Chasing")
		return "Chase", targetPosition
	end

	aimUI.attackSafetyPaused = true
	if aimUI.attackSafetyFriendlyUserId ~= hazardPlayer.UserId then
		aimUI.attackSafetyFriendlyUserId = hazardPlayer.UserId
		aimUI.attackRetreatIssued = false
		aimUI.attackRetreatPosition = nil
	end

	local localTargetDistance = (localPosition - targetPosition).Magnitude
	local isCheckmate = localTargetDistance <= aimUI.attackCheckmateTargetDistance
		and hazardTargetDistance <= aimUI.attackCheckmateFriendlyDistance

	if isCheckmate and not aimUI.attackRetreatIssued then
		local awayFromTarget = localPosition - targetPosition
		local awayFromFriendly = localPosition - hazardRoot.Position
		local escape = Vector3.new(
			awayFromTarget.X + awayFromFriendly.X * 0.65,
			0,
			awayFromTarget.Z + awayFromFriendly.Z * 0.65
		)
		if escape.Magnitude < 0.05 then
			local targetLook = targetRoot.CFrame.LookVector
			escape = Vector3.new(-targetLook.X, 0, -targetLook.Z)
		end
		if escape.Magnitude < 0.05 then
			escape = Vector3.new(0, 0, 1)
		end

		aimUI.attackRetreatIssued = true
		aimUI.attackRetreatPosition = localPosition
			+ escape.Unit * aimUI.attackRetreatDistance
	end

	if aimUI.attackRetreatIssued and aimUI.attackRetreatPosition then
		local retreatRemaining = (localPosition - aimUI.attackRetreatPosition).Magnitude
		if retreatRemaining > 1.25 then
			screenGui:SetAttribute("AttackSafetyState", "Retreating")
			return "Retreat", aimUI.attackRetreatPosition
		end
	end

	screenGui:SetAttribute("AttackSafetyState", "Paused")
	return "Pause", nil
end

local function issueMoveTo(humanoid, target, force)
	local now = os.clock()
	local targetChanged = not lastIssuedMoveTarget
		or (target - lastIssuedMoveTarget).Magnitude >= MOVE_TARGET_EPSILON
	local keepaliveExpired = now - lastMoveIssuedAt >= MOVE_KEEPALIVE

	if force or targetChanged or keepaliveExpired then
		humanoid.AutoRotate = true
		humanoid:MoveTo(target)
		lastIssuedMoveTarget = target
		lastMoveIssuedAt = now
	end
end


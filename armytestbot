local function stopActiveMovement()
	if followMovementActive then
		stopLocalMovement()
	end
	activeMoveTarget = nil
	followMovementActive = false
	lastIssuedMoveTarget = nil
	lastMoveIssuedAt = 0
end

cancelActiveCommand = function(turnEverythingOff)
	local previousMode = commandMode
	stopActiveMovement()
	commandMode = "None"
	activeCommander = nil
	followTarget = nil
	attackTarget = nil
	table.clear(attackTargets)
	holdPosition = nil
	localWasUnavailable = false
	commanderWasUnavailable = false
	targetWasUnavailable = false
	lastAttackAt = 0
	aimUI.resetAttackSafety()

	if previousMode == "Attack" then
		setAttackEnabled(false)
	end

	if turnEverythingOff then
		setFollowEnabled(false)
		setAttackEnabled(false)
		deathFollowEnabled = false
		deathAttackEnabled = false
		updateToggleVisual(deathFollowButton, deathFollowStroke, "Death Follow", false)
		updateToggleVisual(deathAttackButton, deathAttackStroke, "Death Attack", false)
	end
end


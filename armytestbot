	toolPickerLayout.Padding = UDim.new(0, math.max(8, math.floor(10 * compactScale)))
	toolPickerBox.TextSize = math.max(12, math.floor(14 * compactScale))
	toolPickerPadding.PaddingLeft = UDim.new(0, math.floor(14 * compactScale))
	toolPickerPadding.PaddingRight = UDim.new(0, math.floor(12 * compactScale))

	aimUI.masterButton.Size = UDim2.new(1, 0, 0, math.max(40, math.floor(44 * compactScale)))
	aimUI.toggleRow.Size = UDim2.new(1, 0, 0, math.max(40, math.floor(44 * compactScale)))
	aimUI.toggleLayout.Padding = UDim.new(0, math.max(6, math.floor(8 * compactScale)))
	aimUI.shiftlockButton.Size = UDim2.new(1, 0, 0, math.max(38, math.floor(42 * compactScale)))
	aimUI.slider.Size = UDim2.new(1, 0, 0, math.max(50, math.floor(54 * compactScale)))
	aimUI.sliderLabel.TextSize = math.max(11, math.floor(12 * compactScale))
	aimUI.baddiesButton.Size = UDim2.new(1, 0, 0, math.max(40, math.floor(44 * compactScale)))
	aimUI.commandListButton.Size = UDim2.new(1, 0, 0, math.max(40, math.floor(44 * compactScale)))
	aimUI.commandListBody.Size = UDim2.new(1, 0, 0, if targetWidth < 360 then 560 else 430)
	aimUI.commandListBody.TextSize = math.max(10, math.floor(12 * compactScale))

	hint.Size = UDim2.new(1, 0, 0, math.max(18, math.floor(20 * compactScale)))
	hint.TextSize = math.max(12, math.floor(13 * compactScale))
	results.Size = UDim2.new(1, 0, 0, math.max(40, math.floor(42 * compactScale)))
	results.TextSize = math.max(12, math.floor(14 * compactScale))

	local resultPadding = math.floor(12 * compactScale)
	resultsPadding.PaddingTop = UDim.new(0, resultPadding)
	resultsPadding.PaddingBottom = UDim.new(0, resultPadding)
	resultsPadding.PaddingLeft = UDim.new(0, math.floor(14 * compactScale))
	resultsPadding.PaddingRight = UDim.new(0, math.floor(14 * compactScale))

	if window.Visible then
		window.Position = if windowHasMoved
			then clampPosition(window, window.Position)
			else UDim2.fromScale(0.5, 0.5)
	elseif minimizedTab.Visible then
		minimizedTab.Position = if tabHasMoved
			then clampPosition(minimizedTab, minimizedTab.Position)
			else UDim2.fromScale(0.5, 0.5)
	end
end

local function watchCurrentCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = connect(camera:GetPropertyChangedSignal("ViewportSize"), applyResponsiveLayout)
	end

	applyResponsiveLayout()
end


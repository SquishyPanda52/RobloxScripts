local function setMinimized(value)
	minimized = value
	content.Visible = not value
	minimizeButton.Text = value and "□" or "−"
	local size = value and UDim2.fromOffset(390, 56) or UDim2.fromOffset(390, 284)
	TweenService:Create(main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = size}):Play()
	TweenService:Create(shadow, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = value and UDim2.fromOffset(390, 56) or UDim2.fromOffset(390, 284),
	}):Play()
end

minimizeButton.Activated:Connect(function()
	setMinimized(not minimized)
end)

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		panelStart = main.Position
		dragInput = input
	end
end)

header.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput and dragStart and panelStart then
		local delta = input.Position - dragStart
		local newPosition = UDim2.new(panelStart.X.Scale, panelStart.X.Offset + delta.X, panelStart.Y.Scale, panelStart.Y.Offset + delta.Y)
		main.Position = newPosition
		shadow.Position = newPosition + UDim2.fromOffset(0, 10)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == dragInput then
		dragging = false
		dragInput = nil
	end
end)

local character
local humanoid
local rootPart
local diedConnection
local flightEnabled = false
local rising = false
local descending = false
local bodyVelocity
local bodyGyro
local controls

task.spawn(function()
	local playerModule = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
	controls = require(playerModule):GetControls()
end)

local function getCharacterParts()
	character = player.Character or player.CharacterAdded:Wait()
	humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid")
	rootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart")
	if diedConnection then
		diedConnection:Disconnect()
	end
	diedConnection = humanoid.Died:Connect(function()
		if flightEnabled then
			flightEnabled = false
			rising = false
			descending = false
			if bodyVelocity then bodyVelocity:Destroy() end
			if bodyGyro then bodyGyro:Destroy() end
			bodyVelocity = nil
			bodyGyro = nil
			stateLabel.Text = "OFFLINE • RESPAWN DETECTED"
			stateLabel.TextColor3 = Color3.fromRGB(189, 126, 126)
			TweenService:Create(toggleKnob, TweenInfo.new(0.15), {Position = UDim2.fromOffset(4, 14), BackgroundColor3 = Color3.fromRGB(135, 40, 40)}):Play()
			TweenService:Create(flightButton, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(23, 23, 26)}):Play()
			pillStroke.Color = Color3.fromRGB(115, 26, 26)
			flightStroke.Color = Color3.fromRGB(119, 22, 22)
		end
	end)
end

getCharacterParts()

player.CharacterAdded:Connect(function()
	task.wait(0.15)
	getCharacterParts()
end)

local function stopFlight()
	flightEnabled = false
	rising = false
	descending = false
	if bodyVelocity then bodyVelocity:Destroy() end
	if bodyGyro then bodyGyro:Destroy() end
	bodyVelocity = nil
	bodyGyro = nil
	if humanoid and humanoid.Parent and humanoid.Health > 0 then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
	stateLabel.Text = "OFFLINE"
	stateLabel.TextColor3 = Color3.fromRGB(189, 126, 126)
	TweenService:Create(toggleKnob, TweenInfo.new(0.15), {Position = UDim2.fromOffset(4, 14), BackgroundColor3 = Color3.fromRGB(135, 40, 40)}):Play()
	TweenService:Create(flightButton, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(23, 23, 26)}):Play()
	pillStroke.Color = Color3.fromRGB(115, 26, 26)
	flightStroke.Color = Color3.fromRGB(119, 22, 22)
end

local function startFlight()
	getCharacterParts()
	if not humanoid or humanoid.Health <= 0 or not rootPart then
		return
	end
	flightEnabled = true
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false
	bodyVelocity = create("BodyVelocity", {
		Name = "LocalFlightVelocity",
		MaxForce = Vector3.new(100000, 100000, 100000),
		P = 1400,
		Velocity = Vector3.zero,
		Parent = rootPart,
	})
	bodyGyro = create("BodyGyro", {
		Name = "LocalFlightGyro",
		MaxTorque = Vector3.new(100000, 100000, 100000),
		P = 9000,
		D = 300,
		CFrame = workspace.CurrentCamera.CFrame,
		Parent = rootPart,
	})
	stateLabel.Text = "ONLINE • LOCAL ONLY"
	stateLabel.TextColor3 = Color3.fromRGB(255, 204, 204)
	TweenService:Create(toggleKnob, TweenInfo.new(0.15), {Position = UDim2.new(1, -24, 0, 14), BackgroundColor3 = Color3.fromRGB(255, 63, 63)}):Play()
	TweenService:Create(flightButton, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(93, 9, 10)}):Play()
	pillStroke.Color = Color3.fromRGB(255, 73, 73)
	flightStroke.Color = Color3.fromRGB(255, 73, 73)
end

flightButton.Activated:Connect(function()
	if flightEnabled then
		stopFlight()
	else
		startFlight()
	end
end)

local function bindThrust(button, direction)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if direction == 1 then rising = true else descending = true end
			button.BackgroundColor3 = Color3.fromRGB(94, 14, 16)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if direction == 1 then rising = false else descending = false end
			button.BackgroundColor3 = Color3.fromRGB(25, 19, 21)
		end
	end)
end

bindThrust(upButton, 1)
bindThrust(downButton, -1)

UserInputService.InputBegan:Connect(function(input)
	if UserInputService:GetFocusedTextBox() then return end
	if input.KeyCode == Enum.KeyCode.Space then
		rising = true
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
		descending = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Space then
		rising = false
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
		descending = false
	end
end)

local flightLoop = RunService.RenderStepped:Connect(function()
	if not flightEnabled then return end
	if not humanoid or not rootPart or humanoid.Health <= 0 or not rootPart.Parent then
		stopFlight()
		return
	end
	if not bodyVelocity or not bodyGyro or bodyVelocity.Parent ~= rootPart or bodyGyro.Parent ~= rootPart then
		stopFlight()
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then return end
	local moveVector = Vector3.zero
	if controls then
		local ok, result = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(result) == "Vector3" then
			moveVector = result
		end
	end

	-- Preserve the camera's full direction: looking up/down changes forward flight altitude.
	local cameraMovement = camera.CFrame.RightVector * moveVector.X - camera.CFrame.LookVector * moveVector.Z
	if cameraMovement.Magnitude > 1 then
		cameraMovement = cameraMovement.Unit
	end

	local vertical = (rising and 1 or 0) - (descending and 1 or 0)
	bodyVelocity.Velocity = cameraMovement * 58 + Vector3.new(0, vertical * 46, 0)
	bodyGyro.CFrame = camera.CFrame
end)

closeButton.Activated:Connect(function()
	stopFlight()
	flightLoop:Disconnect()
	if diedConnection then diedConnection:Disconnect() end
	gui:Destroy()
	script:Destroy()
end)

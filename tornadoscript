	main.Size = UDim2.fromOffset(380, state.minimized and 52 or 470)
	minimize.Text = state.minimized and "+" or "-"
	clampPanel()
end)

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
overlap.RespectCanCollide = false
overlap.MaxParts = 0

local function boxDistance(position, part)
	local p = part.CFrame:PointToObjectSpace(position)
	local h = part.Size * 0.5
	local closest = Vector3.new(math.clamp(p.X, -h.X, h.X), math.clamp(p.Y, -h.Y, h.Y), math.clamp(p.Z, -h.Z, h.Z))
	return (p - closest).Magnitude
end

local function scan(root)
	local remove = {}
	for assembly, record in pairs(controlled) do
		local valid = assembly:IsDescendantOf(workspace) and not assembly.Anchored and assembly.AssemblyRootPart == assembly
		local nearest = math.huge
		for part in pairs(record.parts) do
			if not part:IsDescendantOf(workspace) or part.Anchored or protectedPart(part) or part.AssemblyRootPart ~= assembly then
				valid = false
				break
			end
			nearest = math.min(nearest, boxDistance(root.Position, part))
		end
		if not valid or nearest > settings.range + 1 then table.insert(remove, assembly) end
	end
	for _, assembly in ipairs(remove) do restore(assembly) end

	overlap.FilterDescendantsInstances = player.Character and { player.Character } or {}
	local parts = workspace:GetPartBoundsInRadius(root.Position, settings.range, overlap)
	local seen = {}
	for _, part in ipairs(parts) do
		local assembly = part.AssemblyRootPart or part
		if not seen[assembly] and not controlled[assembly] and not part.Anchored and not protectedPart(part) then
			if boxDistance(root.Position, part) <= settings.range then
				seen[assembly] = true
				capture(assembly)
			end
		end
	end
end

local function update(dt)
	if state.closed then return end
	layout()
	if not state.enabled then return end
	local root = characterRoot()
	if not root then
		if next(controlled) then restoreAll() end
		status.Text = "WAITING FOR RESPAWN\nPull will resume with your next character."
		return
	end
	scanClock += dt
	if scanClock >= scanInterval then
		scanClock = 0
		scan(root)
	end

	local count = 0
	local invalid = {}
	local step = math.min(dt, 0.1)
	for assembly, record in pairs(controlled) do
		if not assembly.Parent or assembly.Anchored or assembly.AssemblyRootPart ~= assembly then
			table.insert(invalid, assembly)
		else
			-- Fixed world directions prevent objects orbiting when the player turns.
			local angle = record.slot * 2.399963229728653
			local target = root.Position + Vector3.new(math.cos(angle) * 6, 2, math.sin(angle) * 6)
			local center = record.pose:PointToWorldSpace(record.centerOffset)
			local delta = target - center
			local distance = delta.Magnitude
			-- Exponential arrival controls deceleration independently from the speed cap.
			local travel = math.min(settings.speed * step, distance * (1 - math.exp(-settings.landing * step)))
			if distance > 0.0001 then record.pose = record.pose + delta * (travel / distance) end
			local ok = pcall(function()
				-- Read from the persistent local pose, so gravity/network updates cannot
				-- reset the interpolation every frame. Mass and shape do not affect it.
				for part in pairs(record.parts) do
					part.CanCollide = false
				end
				assembly.AssemblyLinearVelocity = Vector3.zero
				assembly.AssemblyAngularVelocity = Vector3.zero
				assembly.CFrame = record.pose
			end)
			if ok then count += 1 else table.insert(invalid, assembly) end
		end
	end
	for _, assembly in ipairs(invalid) do restore(assembly) end
	local message = string.format("PULLING: %d assemblies\nLocal effect. OFF restores starting positions.", count)
	if status.Text ~= message then status.Text = message end
end

connect(pull.Activated, function()
	state.enabled = not state.enabled
	pull.Text = state.enabled and "PULL: ON" or "PULL: OFF"
	pull.BackgroundColor3 = state.enabled and Color3.fromRGB(37, 113, 89) or Color3.fromRGB(83, 43, 58)
	scanClock = scanInterval
	if not state.enabled then
		restoreAll()
		status.Text = "PAUSED\nCaptured objects and collision settings restored."
	end
end)
connect(player.CharacterRemoving, restoreAll)
connect(player.CharacterAdded, function() restoreAll(); scanClock = scanInterval end)

shutdown = function(destroyScript)
	if state.closed then return end
	state.closed = true
	state.enabled = false
	RunService:UnbindFromRenderStep(renderName)
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	restoreAll()
	if gui.Parent then gui:Destroy() end
	if destroyScript and script.Parent then script:Destroy() end
end
connect(cleanupEvent.Event, function() shutdown(false) end)
connect(gui.Destroying, function() shutdown(false) end)
connect(script.Destroying, function() shutdown(false) end)
connect(close.Activated, function() shutdown(true) end)
RunService:BindToRenderStep(renderName, Enum.RenderPriority.Camera.Value - 1, update)
layout()

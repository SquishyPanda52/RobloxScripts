local scanClock = 0
local scanInterval = 0.2
local renderName = "TornadoPull_" .. HttpService:GenerateGUID(false)
local nextSlot = 0
local shutdown

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function make(className, parent, properties)
	local instance = Instance.new(className)
	for key, value in pairs(properties) do instance[key] = value end
	instance.Parent = parent
	return instance
end

local function round(object, radius)
	make("UICorner", object, { CornerRadius = UDim.new(0, radius) })
end

local function protectedPart(part)
	local ancestor = part
	while ancestor and ancestor ~= workspace do
		if ancestor:IsA("Tool") or ancestor:IsA("Accessory") then return true end
		if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then return true end
		ancestor = ancestor.Parent
	end
	return false
end

local function characterRoot()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function restore(root)
	local record = controlled[root]
	if not record then return end
	controlled[root] = nil
	-- Restore the starting pose before enabling collisions; never drop a pile
	-- of overlapping parts on the player. Do not unanchor anything.
	if root.Parent and not root.Anchored and root.AssemblyRootPart == root then
		pcall(function()
			root.CFrame = record.startCFrame
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end)
	end
	for part, saved in pairs(record.parts) do
		if part.Parent then
			pcall(function()
				part.CanCollide = saved.collide
			end)
		end
	end
end

local function restoreAll()
	local roots = {}
	for root in pairs(controlled) do table.insert(roots, root) end
	for _, root in ipairs(roots) do restore(root) end
	nextSlot = 0
end

local function capture(root)
	if controlled[root] or not root.Parent or root.Anchored or protectedPart(root) then return end
	local parts = root:GetConnectedParts(true)
	if not table.find(parts, root) then table.insert(parts, root) end
	-- Check the entire connected assembly, including welded character/tool parts.
	for _, part in ipairs(parts) do
		if part.Anchored or protectedPart(part) then return end
	end
	local savedParts = {}
	for _, part in ipairs(parts) do
		savedParts[part] = { collide = part.CanCollide }
	end
	nextSlot += 1
	controlled[root] = {
		startCFrame = root.CFrame,
		pose = root.CFrame,
		centerOffset = root.CFrame:PointToObjectSpace(root.AssemblyCenterOfMass),
		parts = savedParts,
		slot = nextSlot,
	}
	for part in pairs(savedParts) do
		part.CanCollide = false
	end
end


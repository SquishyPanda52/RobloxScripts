local inventory, inventorySignature = {}, ""
local page, pageSize = 1, 12
local function clearRows(container)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
end
drawInventory = function()
	if not state.selection then return end
	local filtered, chosen = {}, 0
	local query = string.lower(trim(filterBox.Text))
	for _, entry in ipairs(inventory) do
		if selected[entry.root] then chosen += 1 end
		if query == "" or string.find(string.lower(entry.description), query, 1, true) then table.insert(filtered, entry) end
	end
	local pages = math.max(1, math.ceil(#filtered / pageSize))
	page = math.clamp(page, 1, pages)
	inventoryInfo.Text = string.format("%d unanchored assemblies · %d selected", #inventory, chosen)
	pageLabel.Text = string.format("%d / %d", page, pages)
	clearRows(objectList)
	for index = (page - 1) * pageSize + 1, math.min(page * pageSize, #filtered) do
		local entry = filtered[index]
		local row = button(objectList, "Object_" .. entry.id, "", index)
		row.Size = UDim2.new(1, 0, 0, 52)
		row.TextSize = 10
		row.TextWrapped = true
		row.Text = (selected[entry.root] and "[✓] " or "[ ] ") .. entry.description
		row.BackgroundColor3 = selected[entry.root] and Color3.fromRGB(38, 94, 78) or Color3.fromRGB(43, 50, 66)
		-- These connections belong to their row and are released when it is destroyed.
		row.Activated:Connect(function()
			if not state.selection or not entry.root.Parent then return end
			selected[entry.root] = not selected[entry.root] or nil
			scanClock = scanInterval
			drawInventory()
		end)
	end
end

refreshInventory = function()
	if not state.selection then return end
	local roots, result, signatures = {}, {}, {}
	for part in pairs(registry) do
		if part:IsDescendantOf(workspace) and not part.Anchored and not protectedPart(part) then
			local root = part.AssemblyRootPart or part
			if not roots[root] then
				roots[root] = true
				local parts = assemblyParts(root)
				if parts then
					local id = getObjectId(root)
					local names = {}
					for i = 1, math.min(3, #parts) do table.insert(names, parts[i].Name) end
					local size = root.Size
					local description = string.format("#%d %s · %s · %.0fx%.0fx%.0f\n%s (%d part%s)",
						id, table.concat(names, ", "), root.ClassName, size.X, size.Y, size.Z,
						root:GetFullName(), #parts, #parts == 1 and "" or "s")
					table.insert(result, { root = root, id = id, description = description })
				end
			end
		end
	end
	table.sort(result, function(a, b) return a.id < b.id end)
	for _, entry in ipairs(result) do table.insert(signatures, entry.description) end
	local signature = table.concat(signatures, "|")
	inventory = result
	if signature ~= inventorySignature then
		inventorySignature = signature
		drawInventory()
		if drawGroups then drawGroups() end
	end
end
drawGroups = function()
	clearRows(groupList)
	local names = {}
	for name in pairs(groups) do table.insert(names, name) end
	table.sort(names)
	for i, name in ipairs(names) do
		local set = groups[name]
		local count = 0
		for root in pairs(set) do if root:IsDescendantOf(workspace) then count += 1 end end
		local row = make("Frame", groupList, {
			Name = "Group_" .. i, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1,
		})
		local loadButton = button(row, "Load", string.format("%s (%d)", name, count), 0)
		loadButton.Size = UDim2.new(1, -82, 1, 0)
		loadButton.TextTruncate = Enum.TextTruncate.AtEnd
		local add = button(row, "Add", "+", 0)
		add.Position = UDim2.new(1, -76, 0, 0); add.Size = UDim2.fromOffset(34, 36)
		local delete = button(row, "Delete", "X", 0)
		delete.Position = UDim2.new(1, -36, 0, 0); delete.Size = UDim2.fromOffset(34, 36)
		local function apply(additive)
			if not state.selection then return end
			if not additive then table.clear(selected) end
			for root in pairs(set) do if root:IsDescendantOf(workspace) then selected[root] = true end end
			groupName.Text = name
			scanClock = scanInterval
			drawInventory()
		end
		loadButton.Activated:Connect(function() apply(false) end)
		add.Activated:Connect(function() apply(true) end)
		delete.Activated:Connect(function()
			if not state.selection then return end
			groups[name] = nil
			drawGroups()
		end)
	end
end

	table.insert(connections, connection)
	return connection
end

local function make(className, parent, properties)
	local instance = Instance.new(className)
	for key, value in pairs(properties) do instance[key] = value end
	instance.Parent = parent
	return instance
end

local function round(object, radius)
	make("UICorner", object, { CornerRadius = UDim.new(0, radius) })
end

local function protectedPart(part)
	local ancestor = part
	while ancestor and ancestor ~= workspace do
		if ancestor:IsA("Tool") or ancestor:IsA("Accessory") then return true end
		if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then return true end
		ancestor = ancestor.Parent
	end
	return false
end

local function characterRoot(targetPlayer)
	local character = (targetPlayer or player).Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function validAssembly(root, parts)
	if not root:IsDescendantOf(workspace) or root.Anchored or root.AssemblyRootPart ~= root or protectedPart(root) then return false end
	for _, part in ipairs(parts) do
		if not part:IsDescendantOf(workspace) or part.Anchored or part.AssemblyRootPart ~= root or protectedPart(part) then return false end
	end
	return true
end

local function assemblyParts(root)
	local parts = root:GetConnectedParts(true)
	if not table.find(parts, root) then table.insert(parts, root) end
	return validAssembly(root, parts) and parts or nil
end

local function writePose(root, pose)
	-- Existing collision flags stay untouched, even while returning or spinning.
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = pose
end

local function restoreInstant(root)
	local record = controlled[root]
	if not record then return end
	controlled[root] = nil
	if validAssembly(root, record.parts) then
		pcall(writePose, root, record.startCFrame)
	end
end

local function requestReturn(root)
	local record = controlled[root]
	if not record then return end
	if settings.returnSpeed == 0 then
		restoreInstant(root)
	else
		record.mode = "return"
		record.lastTarget = nil
		record.arrived = false
	end
end

local function returnAll(instant)
	local roots = {}
	for root in pairs(controlled) do table.insert(roots, root) end
	for _, root in ipairs(roots) do
		if instant then restoreInstant(root) else requestReturn(root) end
	end
end

local function capture(root)
	local previous = controlled[root]
	if previous then previous.mode = "pull"; return end
	local parts = assemblyParts(root)
	if not parts then return end
	nextSlot += 1
	controlled[root] = {
		startCFrame = root.CFrame, pose = root.CFrame, baseRotation = root.CFrame.Rotation,
		centerOffset = root.CFrame:PointToObjectSpace(root.AssemblyCenterOfMass),
		parts = parts, slot = nextSlot, mode = "pull", spinPhase = 0,
	}
end

local function getObjectId(root)
	if not objectIds[root] then nextId += 1; objectIds[root] = nextId end
	return objectIds[root]
end

local function trim(text)
	return text:match("^%s*(.-)%s*$")
end

local function resolveNames(text)
	if trim(text) == "" then return { player }, {} end
	local result, seen, errors = {}, {}, {}
	local players = Players:GetPlayers()
	table.sort(players, function(a, b) return a.UserId < b.UserId end)
	for token in text:gmatch("[^,]+") do
		local query = string.lower(trim(token)):gsub("^@", "")
		if query ~= "" then
			local matches = {}
			for tier = 1, 4 do
				for _, candidate in ipairs(players) do
					local name, display = string.lower(candidate.Name), string.lower(candidate.DisplayName)
					local match = (tier == 1 and name == query)
						or (tier == 2 and display == query)
						or (tier == 3 and (name:sub(1, #query) == query or display:sub(1, #query) == query))
						or (tier == 4 and (name:find(query, 1, true) or display:find(query, 1, true)))
					if match then table.insert(matches, candidate) end
				end
				if #matches > 0 then break end
			end
			if #matches == 0 then table.insert(errors, trim(token)) end
			for _, candidate in ipairs(matches) do
				if not seen[candidate] then seen[candidate] = true; table.insert(result, candidate) end
			end
		end
	end
	if #result == 0 and #errors == 0 then table.insert(errors, "Enter a player name") end
	return result, errors
end


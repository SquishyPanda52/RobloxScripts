local function slider(name, noteText, minimum, maximum, key, order, decimals)
	local row = make("Frame", content, {
		Name = name:gsub(" ", "") .. "Slider", LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 78), BackgroundColor3 = Color3.fromRGB(30, 34, 44),
		BorderSizePixel = 0,
	})
	round(row, 10)
	make("TextLabel", row, {
		Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -94, 0, 20),
		BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamBold,
		TextSize = 13, TextColor3 = Color3.fromRGB(235, 241, 255), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local value = make("TextLabel", row, {
		Name = "Value", Position = UDim2.new(1, -80, 0, 7), Size = UDim2.fromOffset(68, 20),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13,
		TextColor3 = Color3.fromRGB(119, 202, 255), TextXAlignment = Enum.TextXAlignment.Right,
	})
	make("TextLabel", row, {
		Position = UDim2.fromOffset(12, 29), Size = UDim2.new(1, -24, 0, 14),
		BackgroundTransparency = 1, Text = noteText, Font = Enum.Font.Gotham,
		TextSize = 10, TextColor3 = Color3.fromRGB(170, 180, 200), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local hit = make("TextButton", row, {
		Name = "Track", Position = UDim2.fromOffset(12, 46), Size = UDim2.new(1, -24, 0, 28),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	})
	local bar = make("Frame", hit, {
		Position = UDim2.new(0, 0, 0.5, -3), Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = Color3.fromRGB(65, 73, 91), BorderSizePixel = 0,
	})
	round(bar, 4)
	local fill = make("Frame", bar, { BackgroundColor3 = Color3.fromRGB(93, 183, 240), BorderSizePixel = 0 })
	round(fill, 4)
	local knob = make("Frame", bar, {
		Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(235, 247, 255), BorderSizePixel = 0,
	})
	round(knob, 8)
	local function paint()
		local alpha = (settings[key] - minimum) / (maximum - minimum)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		value.Text = decimals == 0 and tostring(settings[key]) or string.format("%.1f", settings[key])
	end
	local function setFromX(x)
		local alpha = math.clamp((x - hit.AbsolutePosition.X) / math.max(1, hit.AbsoluteSize.X), 0, 1)
		local factor = 10 ^ decimals
		settings[key] = math.floor((minimum + alpha * (maximum - minimum)) * factor + 0.5) / factor
		paint()
		scanClock = scanInterval
	end
	connect(hit.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliderDrag = { input = input, update = setFromX }
			content.ScrollingEnabled = false
			setFromX(input.Position.X)
		end
	end)
	paint()
end

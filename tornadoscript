connect(saveGroup.Activated, function()
	if not state.selection then return end
	local name = trim(groupName.Text):sub(1, 40)
	if name == "" then groupNote.Text = "Type a group name first."; return end
	local set = {}
	for root in pairs(selected) do if root:IsDescendantOf(workspace) then set[root] = true end end
	groups[name] = set
	groupNote.Text = "Saved: " .. name .. ". Load replaces; + combines selections."
	drawGroups()
end)
local function register(instance)
	if instance:IsA("BasePart") then registry[instance] = true end
end
for _, instance in ipairs(workspace:GetDescendants()) do register(instance) end
connect(workspace.DescendantAdded, register)
connect(workspace.DescendantRemoving, function(instance)
	registry[instance] = nil
	selected[instance] = nil
	for _, set in pairs(groups) do set[instance] = nil end
	inventoryClock = 1
end)
connect(targetsBox.FocusLost, function() targetClock = 1; scanClock = scanInterval end)

local panelDrag
local viewport = Vector2.zero
local function clampPanel()
	local size = main.AbsoluteSize
	local center = main.AbsolutePosition + size / 2
	local usable = gui.AbsoluteSize
	if usable.X <= 0 or usable.Y <= 0 then return end
	local x = math.clamp(center.X, size.X / 2, math.max(size.X / 2, usable.X - size.X / 2))
	local y = math.clamp(center.Y, size.Y / 2, math.max(size.Y / 2, usable.Y - size.Y / 2))
	main.Position = UDim2.fromOffset(x, y)
end
local function layout()
	local size = gui.AbsoluteSize
	if size == viewport then return end
	viewport = size
	scale.Scale = math.max(0.1, math.min(1, (size.X - 20) / 380, (size.Y - 20) / 470))
	clampPanel()
end
connect(header.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		panelDrag = { input = input, start = input.Position, center = main.AbsolutePosition + main.AbsoluteSize / 2 }
	end
end)
connect(UserInputService.InputChanged, function(input)
	local mouse = input.UserInputType == Enum.UserInputType.MouseMovement
	if sliderDrag and ((mouse and sliderDrag.input.UserInputType == Enum.UserInputType.MouseButton1) or input == sliderDrag.input) then
		sliderDrag.update(input.Position.X)
	elseif panelDrag and ((mouse and panelDrag.input.UserInputType == Enum.UserInputType.MouseButton1) or input == panelDrag.input) then
		local delta = input.Position - panelDrag.start
		main.Position = UDim2.fromOffset(panelDrag.center.X + delta.X, panelDrag.center.Y + delta.Y)
		clampPanel()
	end
end)
connect(UserInputService.InputEnded, function(input)
	if sliderDrag and (input == sliderDrag.input or input.UserInputType == Enum.UserInputType.MouseButton1) then
		sliderDrag = nil
		content.ScrollingEnabled = true
	end
	if panelDrag and (input == panelDrag.input or input.UserInputType == Enum.UserInputType.MouseButton1) then panelDrag = nil end
end)
connect(minimize.Activated, function()
	state.minimized = not state.minimized
	content.Visible = not state.minimized
	main.Size = UDim2.fromOffset(380, state.minimized and 52 or 470)
	minimize.Text = state.minimized and "+" or "-"
	clampPanel()
end)

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
overlap.RespectCanCollide = false
overlap.MaxParts = 0

local function boxDistance(position, part)
	local p = part.CFrame:PointToObjectSpace(position)
	local h = part.Size * 0.5
	local closest = Vector3.new(math.clamp(p.X, -h.X, h.X), math.clamp(p.Y, -h.Y, h.Y), math.clamp(p.Z, -h.Z, h.Z))
	return (p - closest).Magnitude
end

local function allowed(root)
	return not state.selection or selected[root] == true
end

local function scan(root, haveTargets)
	for assembly, record in pairs(controlled) do
		if not validAssembly(assembly, record.parts) then
			controlled[assembly] = nil
		elseif not haveTargets or not allowed(assembly) then
			requestReturn(assembly)
		elseif record.mode == "return" then
			record.mode = "pull"
		end
	end
	if not root or not haveTargets then return end
	overlap.FilterDescendantsInstances = player.Character and { player.Character } or {}
	local seen = {}
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, settings.range, overlap)) do
		local assembly = part.AssemblyRootPart or part
		if not seen[assembly] and not controlled[assembly] and allowed(assembly) and not part.Anchored and not protectedPart(part) then
			if boxDistance(root.Position, part) <= settings.range then
				seen[assembly] = true
				capture(assembly)
			end
		end
	end
end

local function update(dt)
	if state.closed then return end
	layout()
	local step = math.min(dt, 0.1)
	targetClock += dt
	inventoryClock += dt
	if targetClock >= 0.5 then
		targetClock = 0
		resolvedTargets, targetErrors = resolveNames(targetsBox.Text)
		local names = {}
		for _, p in ipairs(resolvedTargets) do table.insert(names, "@" .. p.Name) end
		targetNote.Text = #targetErrors > 0 and ("Not found: " .. table.concat(targetErrors, ", "))
			or ("Targets: " .. table.concat(names, ", "))
		targetsBox.TextColor3 = #targetErrors > 0 and Color3.fromRGB(255, 131, 139) or Color3.fromRGB(235, 244, 255)
	end
	if inventoryClock >= 1 then inventoryClock = 0; refreshInventory() end

	local aliveTargets = {}
	for _, p in ipairs(resolvedTargets) do
		if p.Parent == Players then
			local root = characterRoot(p)
			if root then table.insert(aliveTargets, { player = p, root = root }) end
		end
	end
	local localRoot = characterRoot()
	if state.enabled then
		scanClock += dt
		if not localRoot then
			returnAll(false)
		elseif scanClock >= scanInterval then
			scanClock = 0
			scan(localRoot, #aliveTargets > 0)
		end
	end
	if state.rotation then orbitPhase = (orbitPhase + math.rad(settings.orbitSpeed) * step) % (2 * math.pi) end

	local active = {}
	for root, record in pairs(controlled) do
		if record.mode == "pull" then table.insert(active, { root = root, record = record }) end
	end
	table.sort(active, function(a, b) return a.record.slot < b.record.slot end)
	local targetCount = #aliveTargets
	local failed = {}
	for index, entry in ipairs(active) do
		local assembly, record = entry.root, entry.record
		if not assembly:IsDescendantOf(workspace) or assembly.Anchored or assembly.AssemblyRootPart ~= assembly then
			table.insert(failed, assembly)
		elseif targetCount == 0 then
			requestReturn(assembly)
		else
			local targetIndex = (index - 1) % targetCount + 1
			local withinIndex = math.floor((index - 1) / targetCount)
			local withinCount = math.floor((#active - targetIndex) / targetCount) + 1
			local target = aliveTargets[targetIndex]
			local phase = 2 * math.pi * withinIndex / withinCount
			local radius = state.rotation and settings.orbitRadius or 6
			local angle = phase + (state.rotation and orbitPhase or 0)
			local point = target.root.Position + Vector3.new(math.cos(angle) * radius, 2, math.sin(angle) * radius)
			local center = record.pose:PointToWorldSpace(record.centerOffset)
			local key = tostring(target.player.UserId) .. ":" .. withinIndex .. ":" .. withinCount .. ":" .. tostring(state.rotation) .. ":" .. radius
			if record.targetKey ~= key then record.arrived = false; record.lastTarget = nil end
			if record.arrived and record.lastTarget then
				local motion = point - record.lastTarget
				if motion.Magnitude < 30 then center += motion else record.arrived = false end
			end
			local delta = point - center
			local distance = delta.Magnitude
			local travel = math.min(settings.speed * step, distance * (1 - math.exp(-settings.landing * step)))
			if distance > 0.0001 then center += delta * (travel / distance) end
			if distance < 0.1 then record.arrived = true end
			local orientation = record.pose.Rotation
			if state.rotation and state.spin then
				record.spinPhase = (record.spinPhase + math.rad(720) * step) % (4 * math.pi)
				orientation = record.baseRotation * CFrame.Angles(record.spinPhase * 0.5, record.spinPhase, record.spinPhase * 0.5)
			end
			record.pose = CFrame.new(center) * orientation * CFrame.new(-record.centerOffset)
			record.lastTarget, record.targetKey = point, key
			record.targetUserId = target.player.UserId
			if not pcall(writePose, assembly, record.pose) then table.insert(failed, assembly) end
		end
	end
	for _, root in ipairs(failed) do controlled[root] = nil end

	local returning, completed = 0, {}
	for assembly, record in pairs(controlled) do
		if record.mode == "return" then
			returning += 1
			if not assembly.Parent or assembly.Anchored or assembly.AssemblyRootPart ~= assembly then
				table.insert(completed, assembly)
			elseif settings.returnSpeed == 0 then
				restoreInstant(assembly)
			else
				local distance = (record.pose.Position - record.startCFrame.Position).Magnitude
				local alpha = math.min(1 - math.exp(-7 * step), settings.returnSpeed * step / math.max(distance, 0.0001))
				record.pose = record.pose:Lerp(record.startCFrame, alpha)
				local _, angle = (record.pose.Rotation:Inverse() * record.startCFrame.Rotation):ToAxisAngle()
				if distance < 0.05 and math.abs(angle) < 0.01 then
					pcall(writePose, assembly, record.startCFrame)
					table.insert(completed, assembly)
				elseif not pcall(writePose, assembly, record.pose) then
					table.insert(completed, assembly)
				end
			end
		end
	end
	for _, root in ipairs(completed) do controlled[root] = nil end
	local text
	if not state.enabled then
		text = returning > 0 and string.format("RETURNING: %d assemblies", returning) or "PAUSED · Objects restored."
	elseif not localRoot then
		text = "WAITING FOR YOUR RESPAWN"
	elseif targetCount == 0 then
		text = "WAITING · No valid living targets"
	else
		text = string.format("PULLING: %d · TARGETS: %d · RETURNING: %d", #active, targetCount, returning)
	end
	status.Text = text .. "\nOriginal collision settings preserved."
end

connect(pull.Activated, function()
	state.enabled = not state.enabled
	pull.Text = state.enabled and "PULL: ON" or "PULL: OFF"
	pull.BackgroundColor3 = state.enabled and Color3.fromRGB(37, 113, 89) or Color3.fromRGB(83, 43, 58)
	scanClock = scanInterval
	targetClock = 1
	if not state.enabled then returnAll(false) end
end)
connect(player.CharacterRemoving, function() returnAll(false) end)
connect(player.CharacterAdded, function() scanClock = scanInterval; targetClock = 1 end)

shutdown = function(destroyScript)
	if state.closed then return end
	state.closed = true
	state.enabled = false
	RunService:UnbindFromRenderStep(renderName)
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	returnAll(true)
	table.clear(registry)
	table.clear(groups)
	table.clear(selected)
	if gui.Parent then gui:Destroy() end
	if destroyScript and script.Parent then script:Destroy() end
end
connect(cleanupEvent.Event, function() shutdown(false) end)
connect(gui.Destroying, function() shutdown(false) end)
connect(script.Destroying, function() shutdown(false) end)
connect(close.Activated, function() shutdown(true) end)
RunService:BindToRenderStep(renderName, Enum.RenderPriority.Camera.Value - 1, update)

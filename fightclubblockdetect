local COLOR_BLOCKING = Color3.fromRGB(255, 95, 95)
local TRANSPARENCY = 0.65

local activeHighlights = {}
local targetBlockTimes = {}
local trackedPlayers = {}
local runtimeConnections = {}

local function rememberConnection(connection)
	table.insert(runtimeConnections, connection)
	return connection
end

local function disconnectConnections(connections)
	for _, connection in ipairs(connections or {}) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)
end

-- Robust Animation ID Extraction with Retry Fallback
local targetBlockId = ""
task.spawn(function()
	while not isClosed and targetBlockId == "" do
		pcall(function()
			local fistAnims = ReplicatedStorage:FindFirstChild("FistAnims")
			if fistAnims then
				local animObj = fistAnims:FindFirstChild("block")
				if animObj and animObj:IsA("Animation") then
					targetBlockId = string.lower(animObj.AnimationId)
				end
			end
		end)
		if targetBlockId ~= "" then
			break
		end
		task.wait(1)
	end
end)


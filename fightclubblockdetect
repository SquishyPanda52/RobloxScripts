-- Robust Animation ID Extraction with Retry Fallback
local targetBlockId = ""
task.spawn(function()
	while targetBlockId == "" do
		pcall(function()
			local fistAnims = ReplicatedStorage:FindFirstChild("FistAnims")
			if fistAnims then
				local animObj = fistAnims:FindFirstChild("block")
				if animObj and animObj:IsA("Animation") then
					targetBlockId = string.lower(animObj.AnimationId)
				end
			end
		end)
		if targetBlockId ~= "" then break end
		task.wait(1)
	end
end)
 

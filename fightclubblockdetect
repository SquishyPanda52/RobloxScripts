----------------------------------------------------
-- RED BLOCK-ONLY ESP LOGIC
----------------------------------------------------
local function removeHighlightForPlayer(player)
	local data = activeHighlights[player]
	if data then
		disconnectConnections(data.connections)
		pcall(function()
			if data.highlight and data.highlight.Parent then
				data.highlight:Destroy()
			end
		end)
		activeHighlights[player] = nil
	end
	targetBlockTimes[player] = nil
end

local function setupHighlight(player, character)
	if isClosed or player == LocalPlayer then
		return
	end

	removeHighlightForPlayer(player)
	if not character or not character.Parent then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "PlayerESP"
	highlight.Adornee = character
	highlight.FillColor = COLOR_BLOCKING
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = TRANSPARENCY
	highlight.OutlineTransparency = TRANSPARENCY + 0.1
	highlight.Enabled = false
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	local connections = {}
	targetBlockTimes[player] = 0

	table.insert(connections, RunService.Heartbeat:Connect(function()
		if isClosed or not highlight.Parent then
			return
		end

		local isBlocking = os.clock() < (targetBlockTimes[player] or 0)
		highlight.Enabled = espEnabled and isBlocking
	end))

	local humanoid = character:WaitForChild("Humanoid", 5)
	if isClosed or not character.Parent then
		highlight:Destroy()
		disconnectConnections(connections)
		return
	end

	if humanoid then
		local animator = humanoid:WaitForChild("Animator", 5)
		if animator then
			table.insert(connections, animator.AnimationPlayed:Connect(function(track)
				if isClosed or not track or not track.Animation then
					return
				end

				local animId = string.lower(track.Animation.AnimationId)
				local animName = string.lower(track.Animation.Name)
				local isBlock = targetBlockId ~= "" and animId == targetBlockId
					or string.find(animName, "block", 1, true) ~= nil
					or string.find(animName, "guard", 1, true) ~= nil

				if isBlock then
					local animLength = track.Length > 0 and track.Length or 1.5
					targetBlockTimes[player] = math.max(
						targetBlockTimes[player] or 0,
						os.clock() + animLength
					)
				end
			end))
		end
	end

	activeHighlights[player] = {
		highlight = highlight,
		connections = connections,
	}
end

local function untrackPlayer(player)
	removeHighlightForPlayer(player)
	local connections = trackedPlayers[player]
	if connections then
		disconnectConnections(connections)
		trackedPlayers[player] = nil
	end
end

local function trackPlayer(player)
	if isClosed or player == LocalPlayer or trackedPlayers[player] then
		return
	end

	local connections = {}
	trackedPlayers[player] = connections

	table.insert(connections, player.CharacterAdded:Connect(function(character)
		task.wait(0.2)
		if not isClosed then
			setupHighlight(player, character)
		end
	end))

	table.insert(connections, player.CharacterRemoving:Connect(function()
		removeHighlightForPlayer(player)
	end))

	if player.Character then
		task.spawn(function()
			setupHighlight(player, player.Character)
		end)
	end
end

rememberConnection(Players.PlayerAdded:Connect(trackPlayer))
rememberConnection(Players.PlayerRemoving:Connect(untrackPlayer))

for _, player in ipairs(Players:GetPlayers()) do
	trackPlayer(player)
end


----------------------------------------------------
-- PERSISTENT BLOCK ESP LOGIC
----------------------------------------------------
local function removeHighlightForPlayer(player)
	if activeHighlights[player] then
		pcall(function()
			if activeHighlights[player].highlight and activeHighlights[player].highlight.Parent then
				activeHighlights[player].highlight:Destroy()
			end
			for _, conn in ipairs(activeHighlights[player].connections or {}) do
				conn:Disconnect()
			end
		end)
		activeHighlights[player] = nil
	end
	targetBlockTimes[player] = nil
end
 
local function setupHighlight(player, character)
	if player == LocalPlayer then return end
	removeHighlightForPlayer(player)
 
	if not character then return end
 
	local highlight = Instance.new("Highlight")
	highlight.Name = "PlayerESP"
	highlight.Adornee = character
	highlight.FillColor = COLOR_DEFAULT
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = TRANSPARENCY
	highlight.OutlineTransparency = TRANSPARENCY + 0.1
	highlight.Enabled = espEnabled
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
 
	pcall(function()
		highlight.Parent = character
	end)
 
	local connections = {}
	targetBlockTimes[player] = 0
 
	table.insert(connections, RunService.Heartbeat:Connect(function()
		if not highlight.Parent then return end
		local endTime = targetBlockTimes[player] or 0
		if os.clock() < endTime then
			highlight.FillColor = COLOR_BLOCKING
		else
			highlight.FillColor = COLOR_DEFAULT
		end
	end))
 
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		local animator = humanoid:WaitForChild("Animator", 5)
		if animator then
			table.insert(connections, animator.AnimationPlayed:Connect(function(track)
				if not track or not track.Animation then return end
				local animId = string.lower(track.Animation.AnimationId)
				local animName = string.lower(track.Animation.Name)
 
				local isBlock = false
				if targetBlockId ~= "" and animId == targetBlockId then
					isBlock = true
				elseif string.find(animName, "block") or string.find(animName, "guard") then
					isBlock = true
				end
 
				if isBlock then
					local animLength = track.Length > 0 and track.Length or 1.5
					targetBlockTimes[player] = math.max(targetBlockTimes[player] or 0, os.clock() + animLength)
				end
			end))
		end
	end
 
	activeHighlights[player] = {
		highlight = highlight,
		connections = connections
	}
end
 
local function trackPlayer(player)
	if player == LocalPlayer then return end
	player.CharacterAdded:Connect(function(character)
		task.wait(0.2)
		setupHighlight(player, character)
	end)
	player.CharacterRemoving:Connect(function()
		removeHighlightForPlayer(player)
	end)
	if player.Character then
		task.spawn(function()
			setupHighlight(player, player.Character)
		end)
	end
end
 
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(removeHighlightForPlayer)
 
for _, player in ipairs(Players:GetPlayers()) do
	trackPlayer(player)
end
 
espButton.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	espButton.Text = espEnabled and "Block ESP: ON" or "Block ESP: OFF"
	espButton.BackgroundColor3 = espEnabled and Color3.fromRGB(40, 160, 90) or Color3.fromRGB(180, 50, 50)
	for _, data in pairs(activeHighlights) do
		if data.highlight and data.highlight.Parent then
			data.highlight.Enabled = espEnabled
		end
	end
end)

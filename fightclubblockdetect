-- UI CONTROLS / CLEAN SHUTDOWN
----------------------------------------------------
rememberConnection(minimizeButton.MouseButton1Click:Connect(function()
	if isClosed then
		return
	end

	isMinimized = not isMinimized
	if isMinimized then
		contentHolder.Visible = false
		mainFrame.Size = UDim2.new(0, 160, 0, 32)
		minimizeButton.Text = "+"
	else
		contentHolder.Visible = true
		mainFrame.Size = UDim2.new(0, 160, 0, 95)
		minimizeButton.Text = "-"
	end
end))

rememberConnection(espButton.MouseButton1Click:Connect(function()
	if isClosed then
		return
	end

	espEnabled = not espEnabled
	espButton.Text = espEnabled and "Block ESP: ON" or "Block ESP: OFF"
	espButton.BackgroundColor3 = espEnabled
		and Color3.fromRGB(40, 160, 90)
		or Color3.fromRGB(180, 50, 50)

	if not espEnabled then
		for _, data in pairs(activeHighlights) do
			if data.highlight and data.highlight.Parent then
				data.highlight.Enabled = false
			end
		end
	end
end))

local function shutdown()
	if isClosed then
		return
	end
	isClosed = true
	espEnabled = false

	disconnectConnections(runtimeConnections)

	local playersToRemove = {}
	for player in pairs(trackedPlayers) do
		table.insert(playersToRemove, player)
	end
	for _, player in ipairs(playersToRemove) do
		untrackPlayer(player)
	end

	local remainingHighlights = {}
	for player in pairs(activeHighlights) do
		table.insert(remainingHighlights, player)
	end
	for _, player in ipairs(remainingHighlights) do
		removeHighlightForPlayer(player)
	end

	table.clear(targetBlockTimes)

	if screenGui and screenGui.Parent then
		screenGui:Destroy()
	end

	task.defer(function()
		pcall(function()
			if script and script.Parent then
				script:Destroy()
			end
		end)
	end)
end

rememberConnection(closeButton.MouseButton1Click:Connect(shutdown))

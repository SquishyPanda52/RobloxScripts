local sliderDragging = false
local function setPredictionFromScreenX(screenX)
	local width = sliderBar.AbsoluteSize.X
	if width <= 0 then
		return
	end
	local alpha = math.clamp((screenX - sliderBar.AbsolutePosition.X) / width, 0, 1)
	predictionStrength = PREDICTION_MIN + (PREDICTION_MAX - PREDICTION_MIN) * alpha
	predictionStrength = math.floor(predictionStrength * 100 + 0.5) / 100
	sliderFill.Size = UDim2.fromScale(alpha, 1)
	sliderKnob.Position = UDim2.fromScale(alpha, 0.5)
	sliderValue.Text = string.format("%.2f", predictionStrength)
end

connect(sliderBar.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = true
		setPredictionFromScreenX(input.Position.X)
	end
end)
connect(sliderKnob.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = true
	end
end)
connect(UserInputService.InputChanged, function(input)
	if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		setPredictionFromScreenX(input.Position.X)
	end
end)
connect(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = false
	end
end)

connect(UserInputService.InputBegan, function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end
	if input.KeyCode == Enum.KeyCode.X then
		setMode("Lockon")
	elseif input.KeyCode == Enum.KeyCode.U then
		setMode("Predict")
	elseif input.KeyCode == Enum.KeyCode.Z then
		state.snap = not state.snap
		updateUI()
	elseif input.KeyCode == Enum.KeyCode.F then
		selectOrUnlockHovered()
	elseif input.KeyCode == Enum.KeyCode.T then
		state.teams = not state.teams
		manualCandidatesDirty = true
		if state.teams and state.selectedTarget and state.selectedTarget:IsA("Player") and isTeammate(state.selectedTarget) then
			resetTargeting("Teammate target removed")
		end
		updateUI()
	elseif input.KeyCode == Enum.KeyCode.Q then
		targetBox:CaptureFocus()
	end
end)

-- Mouse/touch-safe title dragging.
local dragging = false
local dragPointer = nil
local dragStart = Vector2.zero
local startPosition = main.Position

connect(header.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragPointer = input
		dragStart = input.Position
		startPosition = main.Position
	end
end)
connect(UserInputService.InputChanged, function(input)
	if not dragging then
		return
	end
	local matchingMouse = dragPointer and dragPointer.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
	local matchingTouch = input == dragPointer
	if matchingMouse or matchingTouch then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
	end
end)
connect(UserInputService.InputEnded, function(input)
	if input == dragPointer or (dragPointer and dragPointer.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
		dragging = false
		dragPointer = nil
	end
end)

connect(minimizeButton.MouseButton1Click, function()
	state.minimized = not state.minimized
	content.Visible = not state.minimized
	main.Size = state.minimized and UDim2.fromOffset(220, 48) or UDim2.fromOffset(400, 520)
	minimizeButton.Text = state.minimized and "+" or "—"
end)

local function shutdown()
	if state.closed then
		return
	end
	state.closed = true
	state.mode = "Off"
	resetTargeting()
	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)
	table.clear(npcSet)
	table.clear(manualCandidates)
	if screenGui.Parent then
		screenGui:Destroy()
	end
	task.defer(function()
		pcall(function()
			if script and script.Parent then
				script:Destroy()
			end
		end)
	end)
end
connect(closeButton.MouseButton1Click, shutdown)


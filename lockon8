local function setStatus(text, kind)
	if state.closed then
		return
	end
	if status.Text ~= text then
		status.Text = text
	end
	local backgroundColor
	local textColor
	if kind == "error" then
		backgroundColor = Color3.fromRGB(57, 30, 36)
		textColor = Color3.fromRGB(255, 151, 163)
	elseif kind == "active" then
		backgroundColor = Color3.fromRGB(26, 45, 54)
		textColor = Color3.fromRGB(136, 213, 255)
	else
		backgroundColor = Color3.fromRGB(27, 38, 43)
		textColor = Color3.fromRGB(137, 226, 194)
	end
	if status.BackgroundColor3 ~= backgroundColor then
		status.BackgroundColor3 = backgroundColor
	end
	if status.TextColor3 ~= textColor then
		status.TextColor3 = textColor
	end
end


----------------------------------------------------

local function resetTargeting(message)
	state.selectedTarget = nil
	state.hoveredTarget = nil
	state.currentTarget = nil
	state.currentPart = nil
	lastTargetRefresh = 0
	lastHoverRefresh = 0
	if message then
		setStatus(message, "idle")
	end
end

local function setMode(newMode)
	if state.mode == newMode then
		state.mode = "Off"
		resetTargeting("IDLE · Lock On and Predict are OFF")
	else
		state.mode = newMode
		state.currentTarget = nil
		state.currentPart = nil
		manualCandidatesDirty = true
		setStatus(newMode == "Predict" and "PREDICT READY · Choose a target" or "LOCK ON READY · Choose a target", "active")
	end
	updateUI()
end

local function rebuildManualCandidates()
	table.clear(manualCandidates)
	manualCandidatesDirty = false
	local seen = {}

	for entry in string.gmatch(targetBox.Text, "[^,]+") do
		local query = string.lower(trim(entry)):gsub("^@", "")
		if query ~= "" then
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= localPlayer and not isTeammate(player) then
					local username = string.lower(player.Name)
					local displayName = string.lower(player.DisplayName)
					if (string.find(username, query, 1, true) or string.find(displayName, query, 1, true)) and not seen[player] then
						seen[player] = true
						table.insert(manualCandidates, player)
					end
				end
			end

			for model in pairs(npcSet) do
				if model.Parent and string.find(string.lower(model.Name), query, 1, true) and not seen[model] then
					seen[model] = true
					table.insert(manualCandidates, model)
				end
			end
		end
	end
end

local function closestManualTarget()
	if manualCandidatesDirty then
		rebuildManualCandidates()
	end
	local character = localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil, nil
	end

	local bestTarget, bestPart
	local bestDistance = math.huge
	for _, target in ipairs(manualCandidates) do
		local part = targetPart(target)
		if part then
			local distance = (part.Position - root.Position).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				bestTarget = target
				bestPart = part
			end
		end
	end
	return bestTarget, bestPart
end

local function refreshCurrentTarget()
	if state.mode == "Off" then
		state.currentTarget = nil
		state.currentPart = nil
		return
	end

	if state.selectedTarget and state.selectedTarget:IsA("Player") and isTeammate(state.selectedTarget) then
		state.selectedTarget = nil
		setStatus("Teammate ignored because Teams is ON", "idle")
	end
	if state.selectedTarget then
		state.currentTarget = state.selectedTarget
		state.currentPart = targetPart(state.selectedTarget)
	else
		state.currentTarget, state.currentPart = closestManualTarget()
	end
end

local function refreshHoveredTarget()
	state.hoveredTarget = nil
	if state.mode == "Off" or state.selectedTarget then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local inset = select(1, GuiService:GetGuiInset())
	local mousePosition = UserInputService:GetMouseLocation() - inset
	local radius = math.max(75, math.min(AUTO_SELECT_RADIUS, math.min(camera.ViewportSize.X, camera.ViewportSize.Y) * 0.22))
	local closestDistance = radius

	local function consider(target)
		local part = targetPart(target)
		if not part then
			return
		end
		local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
		if not onScreen or screenPoint.Z <= 0 then
			return
		end
		local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePosition).Magnitude
		if distance < closestDistance then
			closestDistance = distance
			state.hoveredTarget = target
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and not isTeammate(player) then
			consider(player)
		end
	end
	for model in pairs(npcSet) do
		if model.Parent then
			consider(model)
		else
			npcSet[model] = nil
		end
	end

	if state.hoveredTarget then
		setStatus("F TO SELECT · " .. targetName(state.hoveredTarget), "active")
	else
		setStatus("Aim near a target and press F, or type a target name", "idle")
	end
end

local function selectOrUnlockHovered()
	if state.mode == "Off" then
		setStatus("Enable Lock On or Predict before selecting", "error")
		return
	end
	if state.selectedTarget then
		state.selectedTarget = nil
		state.currentTarget = nil
		state.currentPart = nil
		setStatus("UNLOCKED · Using typed targets, or press F near another target", "idle")
		return
	end
	refreshHoveredTarget() -- Resolve at the instant F is pressed.
	if state.hoveredTarget and isValidTarget(state.hoveredTarget) then
		state.selectedTarget = state.hoveredTarget
		state.currentTarget = state.hoveredTarget
		state.currentPart = targetPart(state.hoveredTarget)
		setStatus("LOCKED · " .. targetName(state.selectedTarget), "active")
	else
		setStatus("No valid target near the cursor", "error")
	end
end


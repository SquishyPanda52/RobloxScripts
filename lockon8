connect(RunService.RenderStepped, function(deltaTime)
	if state.closed then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.ViewportSize ~= lastViewport then
		lastViewport = camera.ViewportSize
		local fit = math.min(camera.ViewportSize.X / 460, camera.ViewportSize.Y / 600)
		scale.Scale = math.clamp(fit, 0.68, 1)
	end

	-- Hard guarantee: no player/NPC resolution and no camera writes while aim is off.
	if state.mode == "Off" then
		state.currentTarget = nil
		state.currentPart = nil
		return
	end

	local now = os.clock()
	if now - lastHoverRefresh >= HOVER_REFRESH_INTERVAL then
		lastHoverRefresh = now
		refreshHoveredTarget()
	end
	if now - lastTargetRefresh >= TARGET_REFRESH_INTERVAL then
		lastTargetRefresh = now
		refreshCurrentTarget()
	end

	local target = state.currentTarget
	local part = target and targetPart(target) or nil
	state.currentPart = part
	if not target or not part then
		if state.selectedTarget then
			setStatus("WAITING FOR RESPAWN · " .. targetName(state.selectedTarget), "idle")
		elseif not state.hoveredTarget and trim(targetBox.Text) == "" then
			setStatus("Enter a target name or press F near a target", "idle")
		end
		return
	end

	local targetPosition = part.Position
	if state.mode == "Predict" then
		targetPosition += part.AssemblyLinearVelocity * predictionStrength
	end

	local desired = CFrame.lookAt(camera.CFrame.Position, targetPosition)
	if state.snap then
		camera.CFrame = desired
	else
		local alpha = 1 - math.exp(-SMOOTH_SPEED * math.min(deltaTime, 0.1))
		camera.CFrame = camera.CFrame:Lerp(desired, alpha)
	end

	if not state.selectedTarget then
		setStatus((state.mode == "Predict" and "PREDICTING · " or "LOCKED · ") .. targetName(target), "active")
	end
end)

updateUI()

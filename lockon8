	oldGui:Destroy()
end

local state = {
	closed = false,
	minimized = false,
	mode = "Off", -- Off, Lockon, or Predict
	snap = false,
	teams = false,
	selectedTarget = nil,
	hoveredTarget = nil,
	currentTarget = nil,
	currentPart = nil,
}

local PREDICTION_MIN = 0
local PREDICTION_MAX = 0.5
local predictionStrength = 0.1
local TARGET_REFRESH_INTERVAL = 0.05
local HOVER_REFRESH_INTERVAL = 0.05
local AUTO_SELECT_RADIUS = 125
local SMOOTH_SPEED = 14

local connections = {}
local npcSet = {}
local manualCandidates = {}
local manualCandidatesDirty = true
local lastTargetRefresh = 0
local lastHoverRefresh = 0
local lastViewport = Vector2.zero

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function trim(value)
	return tostring(value or ""):match("^%s*(.-)%s*$")
end

local function targetName(target)
	if not target then
		return "None"
	end
	if target:IsA("Player") then
		return target.DisplayName .. " (@" .. target.Name .. ")"
	end
	return target.Name
end

local function isTeammate(player)
	if not state.teams or not player or player == localPlayer then
		return false
	end
	if localPlayer.Neutral or player.Neutral then
		return false
	end
	return localPlayer.Team ~= nil and player.Team == localPlayer.Team
end

local function modelIsNPC(model)
	if not model or not model:IsA("Model") or model == localPlayer.Character then
		return false
	end
	if Players:GetPlayerFromCharacter(model) then
		return false
	end
	return model:FindFirstChildOfClass("Humanoid") ~= nil
		or model:FindFirstChild("HumanoidRootPart") ~= nil
		or model.PrimaryPart ~= nil
end

local function addNPC(instance)
	if instance:IsA("Model") and modelIsNPC(instance) then
		npcSet[instance] = true
		manualCandidatesDirty = true
		return
	end
	local model = instance:FindFirstAncestorOfClass("Model")
	if model and modelIsNPC(model) then
		npcSet[model] = true
		manualCandidatesDirty = true
	end
end

local function targetCharacter(target)
	if not target or not target.Parent then
		return nil
	end
	if target:IsA("Player") then
		if target == localPlayer or isTeammate(target) then
			return nil
		end
		return target.Character
	end
	if target:IsA("Model") and modelIsNPC(target) then
		return target
	end
	return nil
end

local function targetPart(target)
	local character = targetCharacter(target)
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health <= 0 then
		return nil
	end
	local part = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function isValidTarget(target)
	return targetPart(target) ~= nil
end

for _, instance in ipairs(workspace:GetDescendants()) do
	if instance:IsA("Model") then
		addNPC(instance)
	end
end

connect(workspace.DescendantAdded, addNPC)
connect(workspace.DescendantRemoving, function(instance)
	if npcSet[instance] then
		npcSet[instance] = nil
		manualCandidatesDirty = true
	end
end)

